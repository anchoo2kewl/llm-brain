#!/usr/bin/env bash
# llm-run <provider> <mode> <cwd> <prompt-file> [session-name]
#
# One adapter for every LLM CLI so the fleet never hard-codes a vendor.
#   mode=write   full tool access (implementation, PR babysitting)
#   mode=review  read-only (internal review); prints findings to stdout
set -euo pipefail
source "$(dirname "$0")/lib.sh"

provider="$1" mode="$2" cwd="$3" prompt_file="$4" name="${5:-llm-brain}"
prompt="$(cat "$prompt_file")"
model="${LLM_MODEL:-$(cfg ".providers.$provider.model")}"
cd "$cwd"

# Shared memory: add what other agents learned about this repo/issue and who else is on it, and how to save a
# lesson. It fails open: no hub or no memory leaves the prompt as it was.
if [[ "$(cfg '.memory.enabled')" == "true" ]]; then
  export BRAIN_PROVIDER="$provider" BRAIN_AGENT="$name"
  mem="$(BRAIN_HUB_URL="${BRAIN_HUB_URL:-$(cfg '.memory.hub_url // .hub_url')}" "$BRAIN_DIR/bin/brain-context" --k "$(cfg '.memory.k // 8')" 2>/dev/null || true)"
  [[ -n "$mem" ]] && prompt+=$'\n\n'"$mem"
  prompt+=$'\n\n'"When you learn something non-obvious the next agent here would need (a gotcha, a decision and why, how to run or test something), save it with \`$BRAIN_DIR/bin/brain-remember <fact|decision|gotcha|runbook|handoff> \"<title>\" \"<the lesson>\" [--files a,b]\`. Keep it small and verbatim, never a secret. If you stop before the work is done, save a handoff."
fi

# Route through the account gateway when it is enabled and reachable.
GW=""
if [[ "$(cfg '.gateway.enabled')" == "true" ]]; then
  envf="$(cfg '.gateway.env_file')"; envf="${envf/#\~/$HOME}"
  [[ -f "$envf" ]] && source "$envf"
  url="$(cfg '.gateway.url')"
  if [[ -n "${CPA_API_KEY:-}" ]] && curl -fsS -m 3 -o /dev/null -H "Authorization: Bearer $CPA_API_KEY" "$url/v1/models"; then
    GW="$url"; export CPA_API_KEY
  else
    log "gateway $url unreachable — using this machine's own CLI login"
  fi
fi

case "$provider" in
  claude)
    [[ -n "$GW" ]] && export ANTHROPIC_BASE_URL="$GW" ANTHROPIC_AUTH_TOKEN="$CPA_API_KEY"
    args=(-p "$prompt" --name "$name" --output-format text)
    [[ -n "$model" ]] && args+=(--model "$model")
    if [[ "$mode" == "write" ]]; then
      args+=(--dangerously-skip-permissions)
    else
      args+=(--permission-mode plan --allowedTools "Read,Grep,Glob,Bash(git diff:*),Bash(git log:*),Bash(git show:*),Bash(gh pr view:*),Bash(gh pr diff:*)")
    fi
    # A budget hook stops Claude's loop, but the CLI may report exit 0. Preserve
    # human-readable output while translating a guard stop to an incomplete run.
    budget_stop="$(mktemp "$BRAIN_STATE/runs/budget-stop.XXXXXX")"
    trap 'rm -f "$budget_stop"' EXIT
    export BRAIN_CLAUDE_BUDGET_STOP_FILE="$budget_stop"
    rc=0
    claude "${args[@]}" || rc=$?
    if [[ -s "$budget_stop" ]]; then
      printf 'BUDGET_STOPPED %s\n' "$(cat "$budget_stop")" >&2
      exit 75
    fi
    exit "$rc"
    ;;
  codex)
    args=(exec -C "$cwd" --skip-git-repo-check)
    [[ -n "$GW" ]] && args+=(-c model_provider=cpa
      -c "model_providers.cpa={name=\"CPA\",base_url=\"$GW/v1\",env_key=\"CPA_API_KEY\",wire_api=\"responses\",requires_openai_auth=false}")
    [[ -n "$model" ]] && args+=(-m "$model")
    if [[ "$mode" == "write" ]]; then
      args+=(--dangerously-bypass-approvals-and-sandbox)
    else
      args+=(--sandbox read-only)
    fi
    exec codex "${args[@]}" "$prompt"
    ;;
  gemini)
    args=(-p "$prompt")
    [[ -n "$model" ]] && args+=(-m "$model")
    [[ "$mode" == "write" ]] && args+=(--yolo)
    exec gemini "${args[@]}"
    ;;
  *) die "unknown provider: $provider" ;;
esac
