#!/usr/bin/env python3
"""Pick the issues the fleet may take from one repo's `gh issue list` JSON (stdin).

Prints `<repo> <number>` per accepted issue, oldest first. People in `intake.authors`
are taken as before. A bot is taken only through an `intake.bot_authors` rule, and only
when the issue has every required label, the repo's owner is allowed, and the issue is
assigned to `intake.assignee`.
"""
import argparse
import json
import sys


def bot_login(login):
    """`app/github-actions` (gh), `github-actions[bot]` (REST) and `github-actions` are one bot."""
    login = (login or "").strip().lower()
    if login.startswith("app/"):
        login = login[len("app/"):]
    if login.endswith("[bot]"):
        login = login[:-len("[bot]")]
    return login


def is_bot(author):
    login = (author.get("login") or "").lower()
    return author.get("is_bot") is True or login.startswith("app/") or login.endswith("[bot]")


def bot_allowed(issue, repo, assignee, rules):
    author = issue.get("author") or {}
    if not is_bot(author):
        return False
    labels = {label.get("name") for label in issue.get("labels") or []}
    owner = repo.split("/", 1)[0].lower()
    assignees = {(a.get("login") or "").lower() for a in issue.get("assignees") or []}
    for rule in rules or []:
        if bot_login(rule.get("login")) != bot_login(author.get("login")):
            continue
        required = rule.get("require_labels") or []
        owners = [o.lower() for o in rule.get("repo_owners") or []]
        # A rule must name its labels and owners: an empty list never means "any".
        if (required and set(required) <= labels and owner in owners
                and assignee and assignee.lower() in assignees):
            return True
    return False


def accepted(issues, repo, intake, skip):
    authors = intake.get("authors") or []
    rules = intake.get("bot_authors") or []
    assignee = intake.get("assignee") or ""
    out = []
    for issue in sorted(issues, key=lambda i: i.get("createdAt") or ""):
        labels = {label.get("name") for label in issue.get("labels") or []}
        if labels & set(skip):
            continue
        login = (issue.get("author") or {}).get("login")
        if login in authors or bot_allowed(issue, repo, assignee, rules):
            out.append(issue["number"])
    return out


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--repo", required=True, help="owner/name")
    ap.add_argument("--intake", required=True, help="the intake config as JSON")
    ap.add_argument("--skip", required=True, help="labels that rule an issue out, as a JSON list")
    args = ap.parse_args()
    raw = sys.stdin.read().strip()  # `gh` failed or printed nothing: no candidates, like jq on empty input
    for number in accepted(json.loads(raw) if raw else [], args.repo, json.loads(args.intake), json.loads(args.skip)):
        print(f"{args.repo} {number}")


if __name__ == "__main__":
    main()
