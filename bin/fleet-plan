#!/usr/bin/env python3
"""Decide whether a PR change needs a babysitter, without spending an LLM call."""
import argparse
import hashlib
import json
import sys
from pathlib import Path


def digest(value):
    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":")).encode()).hexdigest()


def babysit(pr, previous, owner, notes, marked=True, require_approval=True):
    # Our own acknowledgements/slop comments do not create new work. Human/bot
    # feedback includes bodies and edit times, not just counts (edits matter).
    feedback = {
        key: [item for item in pr.get(key, []) if item.get("author", {}).get("login") != owner]
        for key in ("reviews", "comments")
    }
    checks = []
    for item in pr.get("statusCheckRollup") or []:
        state = item.get("conclusion") or item.get("state") or item.get("status") or "UNKNOWN"
        checks.append((item.get("name") or item.get("context") or "", state.upper()))
    current = {
        "version": 1, "head": pr.get("headRefOid"), "feedback": digest(feedback),
        "notes": notes, "checks": sorted(checks), "merge": pr.get("mergeStateStatus"),
        "decision": pr.get("reviewDecision"), "marked": marked,
    }
    if current == previous:
        return False, "unchanged", current
    new_feedback = any(feedback.values()) and (not previous or current["feedback"] != previous.get("feedback"))
    new_notes = bool(notes) and (not previous or notes != previous.get("notes"))
    states = {state for _, state in checks}
    failed = bool(states & {"FAILURE", "ERROR", "TIMED_OUT", "ACTION_REQUIRED", "CANCELLED", "STARTUP_FAILURE"})
    pending = bool(states & {"PENDING", "IN_PROGRESS", "QUEUED", "EXPECTED", "WAITING", "REQUESTED", "UNKNOWN"})
    if not marked or new_feedback or new_notes or failed or pr.get("mergeStateStatus") == "DIRTY":
        return True, "actionable change", current
    if pending:
        return False, "checks still running; no new feedback", current
    approved = pr.get("reviewDecision") == "APPROVED" or any(
        r.get("state") == "APPROVED" for r in pr.get("reviews", [])
    )
    if require_approval and not approved:
        return False, "waiting for approval; no new feedback", current
    return True, "checks settled; evaluate merge", current


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--previous", type=Path, required=True)
    ap.add_argument("--owner", required=True)
    ap.add_argument("--notes-hash", default="")
    ap.add_argument("--marked", choices=("true", "false"), default="true")
    ap.add_argument("--require-approval", choices=("true", "false"), default="true")
    args = ap.parse_args()
    try:
        previous = json.loads(args.previous.read_text())
        if not isinstance(previous, dict):
            previous = None
    except (OSError, ValueError):
        previous = None  # upgrade from the old concatenated fingerprint
    run, reason, fingerprint = babysit(json.load(sys.stdin), previous, args.owner, args.notes_hash,
                                      args.marked == "true", args.require_approval == "true")
    print(json.dumps({"run": run, "reason": reason, "fingerprint": fingerprint}, sort_keys=True))


if __name__ == "__main__":
    main()
