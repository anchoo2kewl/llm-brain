#!/usr/bin/env bash
# fleet — the issue → PR → merge loop.
#
#   fleet tick              chat-watch + dispatch + babysit + review-prs once (what launchd runs)
#   fleet dispatch          claim agent-ready issues and start implement workers
#   fleet babysit           start a babysit worker for every marker PR with new activity
#   fleet review-prs        review every PR that requests me (once per head commit, until it approves)
#   fleet review-pr <url>   the same for one PR
#   fleet review <pr-url>   cross-LLM internal review of a PR; prints findings
#   fleet slop <pr-url> [--post]  AI Slop Score of a PR; --post also shows it on the PR (comment + commit status)
#   fleet status            claims, running workers, open fleet PRs
#   fleet labels            create the fleet labels in the intake repos (once)
#   fleet pause|resume      this machine only
#   fleet providers         show implementer / reviewer resolution
set -euo pipefail
source "$(dirname "$0")/lib.sh"

spawn() { # spawn <key> <provider> <mode> <timeout> <prompt-file>
  local key="$1" provider="$2" mode="$3" timeout="$4" prompt_file="$5"
  local logf="$BRAIN_STATE/logs/$key.$(date +%Y%m%d-%H%M%S).log"
  nohup gtimeout --kill-after=5m "$timeout" \
    "$BRAIN_DIR/bin/llm-run" "$provider" "$mode" "${SPAWN_CWD:-$WORK_ROOT}" "$prompt_file" "fleet-$key" \
    >"$logf" 2>&1 </dev/null &
  echo $! >"$BRAIN_STATE/runs/$key.pid"
  log "started $key ($provider/$mode, pid $!, log $logf)"
}

capacity_left() { # work workers (implement/babysit); reviews have their own pool
  echo $(( $(cfg '.limits.max_workers') - $(running_workers work) ))
}
review_capacity_left() {
  echo $(( $(cfg '.limits.max_review_workers') - $(running_workers review) ))
}

# A claim is a marker comment; the earliest claim comment wins, so two machines
# racing on the same issue resolve deterministically.
claim_issue() { # claim_issue <repo> <num> -> 0 if we own it
  local repo="$1" num="$2" owner
  gh issue comment "$num" -R "$repo" --body "<!-- llm-brain:claim host=$HOST -->
🤖 Picked up by the llm-brain fleet on \`$HOST_NAME\` (implementer: $(implementer), reviewer: $(reviewer))." >/dev/null
  sleep 5
  owner="$(gh api "repos/$repo/issues/$num/comments" --paginate \
    --jq '[.[] | select(.body | contains("<!-- llm-brain:claim host="))] | first | .body' \
    | sed -nE 's/.*host=([^ ]+) -->.*/\1/p' | head -1)"
  if [[ "$owner" == "$HOST" ]]; then
    gh issue edit "$num" -R "$repo" --add-label "$(cfg '.labels.claimed')" >/dev/null
    return 0
  fi
  log "#$num already claimed by $owner"
  return 1
}

in_flight() { # issues the fleet currently owns, across all machines (labels are the source of truth)
  local repo
  for repo in $(cfg '.intake.repos[]'); do
    gh issue list -R "$repo" --state open --assignee "$(cfg '.intake.assignee')" \
      --label "$(cfg '.labels.claimed')" --json number --jq '.[].number'
    gh issue list -R "$repo" --state open --assignee "$(cfg '.intake.assignee')" \
      --label "$(cfg '.labels.pr_open')" --json number --jq '.[].number'
  done | sort -u
}

# Candidates in order (oldest first): assigned to me, authored by an allowed author, created since the cutoff, not owned yet.
intake_queue() {
  local repo
  for repo in $(cfg '.intake.repos[]'); do
    gh issue list -R "$repo" --state open --assignee "$(cfg '.intake.assignee')" \
      --search "created:>=$(cfg '.intake.created_since') sort:created-asc" --limit 100 \
      --json number,title,author,labels,createdAt \
      | jq -r --arg repo "$repo" --argjson authors "$(cfg -o=json '.intake.authors')" \
          --argjson skip "$(cfg -o=json '.intake.skip_labels + [.labels.claimed, .labels.pr_open, .labels.blocked]')" '
          sort_by(.createdAt) | .[]
          | select(.author.login as $a | $authors | index($a))
          | select([.labels[].name] as $l | ($skip | map(. as $s | $l | index($s)) | all(. == null)))
          | "\($repo) \(.number)"'
  done
}

claimed_before() { # an earlier fleet claim exists (e.g. worker found nothing to build)
  gh api "repos/$1/issues/$2/comments" --paginate --jq '.[].body' 2>/dev/null | grep -q '<!-- llm-brain:claim host='
}

has_my_open_pr() { # has_my_open_pr <num>
  [[ "$(cfg '.intake.skip_if_my_open_pr')" == "true" ]] || return 1
  [[ -n "$(gh search prs "$1" --owner "$(cfg '.pr_owners[0]')" --author "@me" --state open --json url --jq '.[0].url' 2>/dev/null)" ]]
}

cmd_dispatch() {
  paused && { log "paused"; return; }
  local owned slots repo num
  owned="$(in_flight | grep -c . || true)"
  slots=$(( $(cfg '.intake.max_in_flight') - owned ))
  (( slots > 0 )) || { log "in flight: $owned/$(cfg '.intake.max_in_flight') — waiting for a merge"; return; }
  while read -r repo num; do
    [[ -n "$num" ]] || continue
    (( slots > 0 )) || break
    (( $(capacity_left) > 0 )) || { log "no worker capacity"; break; }
    worker_running "issue-$num" && continue
    if has_my_open_pr "$num"; then log "#$num: already being worked by hand (open PR) — skipping"; continue; fi
    if claimed_before "$repo" "$num"; then continue; fi        # one pickup per issue, ever
    claim_issue "$repo" "$num" || continue
    local pf="$BRAIN_STATE/runs/issue-$num.prompt"
    prompt_env implement
    NOTES="$(notes_for "$repo#$num")" REPO="$repo" ISSUE="$num" HOST="$HOST_NAME" REVIEWER="$(reviewer)" IMPLEMENTER="$(implementer)" \
      BRAIN_DIR="$BRAIN_DIR" MARKER="$(cfg '.pr_marker')$num" \
      REVIEWERS="$(cfg '.reviewers | join(",")')" \
      render "$BRAIN_DIR/prompts/implement.md" >"$pf"
    BRAIN_REPO="$repo" BRAIN_ISSUE="$num" spawn "issue-$num" "$(implementer)" write "$(cfg '.limits.implement_timeout')" "$pf"
    slots=$((slots - 1))
  done < <(intake_queue)
}

fleet_prs() { # JSON array of my open PRs for fleet issues: the body marker, or (for an issue the fleet owns) a mention of it
  local marker owner repo owned
  marker="$(cfg '.pr_marker')"
  repo="$(cfg '.intake.repos[0]')"
  owned="$(in_flight | jq -R 'select(length > 0)' | jq -sc .)"
  for owner in $(cfg '.pr_owners[]'); do
    gh search prs --owner "$owner" --author "@me" --state open \
      --json url,number,repository,updatedAt,title,body --limit 100
  done | jq -s --arg m "$marker" --arg repo "$repo" --argjson owned "$owned" '
    ($repo | split("/")[1]) as $name
    | add // [] | unique_by(.url) | map(
        ((.body // "") + "\n" + (.title // "")) as $t
        | ((.body // "") | capture(($m | gsub("[.]"; "\\.")) + "(?<n>[0-9]+)").n // null) as $mk
        # A companion PR opened without the marker still counts when it names an issue the fleet owns
        # ("blue-stack#17446" or the issue URL).
        | ($mk // ([$owned[] | select(. as $n | $t | test("(^|[^A-Za-z0-9_.-])" + $name + "#" + $n + "([^0-9]|$)")
              or test("github\\.com/" + $repo + "/issues/" + $n + "([^0-9]|$)"))][0])) as $issue
        | select($issue != null)
        | {url, number, repository, updatedAt, issue: $issue, marked: ($mk != null)})'
}

cmd_babysit() {
  paused && { log "paused"; return; }
  local row url key fp_file new_fp issue refs plan notes_hash
  fleet_prs | jq -c '.[]' | while read -r row; do
    url="$(jq -r .url <<<"$row")"
    key="pr-$(jq -r '.repository.name + "-" + (.number|tostring)' <<<"$row")"
    slop_publish "$url" || true                               # the fleet's own PRs show their score too
    worker_running "$key" && continue
    issue="$(jq -r '.issue // empty' <<<"$row")"; refs="$(jq -r '.repository.nameWithOwner + "#" + (.number|tostring)' <<<"$row")"
    [[ -n "$issue" ]] && refs="$refs $(cfg '.intake.repos[0]')#$issue"
    if [[ -n "$issue" ]] && gh issue view "$issue" -R "$(cfg '.intake.repos[0]')" --json labels --jq '[.labels[].name]' | grep -q "\"$(cfg '.labels.stop')\""; then
      continue                                                 # someone said stop (label or chat)
    fi
    # Don't race the implementation worker on its own branch.
    [[ -n "$issue" ]] && worker_running "issue-$issue" && continue
    fp_file="$BRAIN_STATE/prs/$key.fp"
    notes_hash=""
    if [[ -n "$(notes_for $refs)" ]]; then notes_hash="$(notes_for $refs | shasum -a 256 | cut -d ' ' -f1)"; fi
    plan="$(gh pr view "$url" --json headRefOid,reviews,comments,statusCheckRollup,mergeStateStatus,reviewDecision \
      | "$BRAIN_DIR/bin/fleet-plan" --previous "$fp_file" --owner "$(cfg '.intake.assignee')" \
          --notes-hash "$notes_hash" --marked "$(jq -r '.marked // false' <<<"$row")" \
          --require-approval "$(cfg '.merge.require_approval')")" || continue
    new_fp="$(jq -c '.fingerprint' <<<"$plan")"
    if [[ "$(jq -r .run <<<"$plan")" != "true" ]]; then
      # Remember skipped CI transitions too, so old feedback doesn't wake another worker.
      echo "$new_fp" >"$fp_file"
      continue
    fi
    (( $(capacity_left) > 0 )) || { log "at capacity"; return; }
    echo "$new_fp" >"$fp_file"
    local pf="$BRAIN_STATE/runs/$key.prompt"
    prompt_env babysit
    NOTES="$(notes_for $refs)" PR_URL="$url" HOST="$HOST_NAME" REVIEWER="$(reviewer)" BRAIN_DIR="$BRAIN_DIR" \
      MARKER="$(cfg '.pr_marker')${issue:-?}" \
      REVIEWERS="$(cfg '.reviewers | join(",")')" AUTO_MERGE="$(cfg '.merge.auto')" \
      render "$BRAIN_DIR/prompts/babysit.md" >"$pf"
    BRAIN_REPO="${refs%%#*}" BRAIN_PR="${refs##*#}" spawn "$key" "$(implementer)" write "$(cfg '.limits.babysit_timeout')" "$pf"
  done
}

cmd_review() {
  local url="$1" rev dir pf
  rev="$(reviewer)"
  dir="$(mktemp -d "$BRAIN_STATE/review.XXXXXX")"
  gh pr view "$url" --json headRepository,headRepositoryOwner,headRefName,baseRefName >"$dir/pr.json"
  local nwo head base
  nwo="$(jq -r '.headRepositoryOwner.login + "/" + .headRepository.name' "$dir/pr.json")"
  head="$(jq -r .headRefName "$dir/pr.json")"; base="$(jq -r .baseRefName "$dir/pr.json")"
  git clone -q --filter=blob:none --branch "$head" "git@github.com:$nwo.git" "$dir/src"
  git -C "$dir/src" fetch -q origin "$base:refs/remotes/origin/$base"
  pf="$dir/prompt.md"
  PR_URL="$url" BASE="origin/$base" render "$BRAIN_DIR/prompts/review.md" >"$pf"
  log "internal review of $url by $rev"
  gtimeout "$(cfg '.limits.review_timeout')" "$BRAIN_DIR/bin/llm-run" "$rev" review "$dir/src" "$pf" "fleet-review" \
    | tee "$dir/findings.md"
  rm -rf "$dir/src"
}

# Trusted Slack requests can ask for review without a GitHub reviewer request.
chat_review_queue() {
  local file url token key seen owner repo row owners
  owners="$(cfg -o=json '.pr_review.owners')"
  for file in "$BRAIN_STATE"/chat/review-requests/*.json; do
    [[ -f "$file" ]] || continue
    url="$(jq -r '.url // ""' "$file")"; token="$(jq -r '.token // ""' "$file")"
    [[ "$url" =~ ^https://github.com/([^/]+)/([^/]+)/pull/([0-9]+)$ && -n "$token" ]] || continue
    owner="${BASH_REMATCH[1]}"; repo="${BASH_REMATCH[2]}"; key="review-$repo-${BASH_REMATCH[3]}"
    jq -e --arg owner "$owner" 'index($owner) != null' <<<"$owners" >/dev/null || continue
    [[ "$repo" =~ $(cfg '.pr_review.repo_regex') ]] || continue
    seen="$(cat "$BRAIN_STATE/prs/$key.chat-reviewed" 2>/dev/null || true)"
    [[ "$token" == "$seen" ]] && continue
    row="$(gh pr view "$url" --json url,author,isDraft,state)" || continue
    if [[ "$(jq -r .state <<<"$row")" != OPEN ]]; then
      mv "$file" "$file.closed"; continue
    fi
    if [[ "$(jq -r .author.login <<<"$row")" == "$(cfg '.owner.github')" ]]; then
      mv "$file" "$file.owned"; continue
    fi
    jq -c --arg repo "$repo" '. + {repository:{name:$repo}} | [.]' <<<"$row"
  done
}

# Assignment, direct/team requests, mentions and trusted chat; no age cutoff.
review_queue() {
  local candidates
  # Capture first: failed discovery must not dispatch a partial queue.
  candidates="$(cfg -o=json '.' | "$BRAIN_DIR/bin/review-discovery")" || return 1
  {
    printf '%s\n' "$candidates"
    chat_review_queue
  } | jq -s --arg me "$(cfg '.owner.github')" --arg re "$(cfg '.pr_review.repo_regex')" '
    add | unique_by(.url) | map(select(.isDraft | not) | select((.author.login // "") | ascii_downcase != ($me | ascii_downcase)) | select(.repository.name | test($re))) | .[].url' -r
}

# Prior feedback for deduplication; only our explicitly marked computed scores are omitted (the current score is supplied separately).
existing_feedback() { # existing_feedback <owner/repo> <number>
  local nwo="$1" num="$2" me
  me="$(cfg '.owner.github')"
  echo "## Reviews"
  gh api "repos/$nwo/pulls/$num/reviews" --paginate | jq -r --arg me "$me" '
    .[] | (if .user.login == $me then ((.body // "") | gsub("<!-- llm-brain:score:start -->[\\s\\S]*?<!-- llm-brain:score:end -->"; "[Previous computed score omitted; current score supplied separately.]")) else (.body // "") end) as $body
    | select($body != "")
    | "### \(.user.login) — \(.state) at \(.submitted_at) (commit \(.commit_id[0:8]))\n\($body)\n"'
  echo "## Inline comments"
  gh api "repos/$nwo/pulls/$num/comments" --paginate \
    --jq '.[] | "### \(.user.login) on \(.path):\(.line // .original_line) at \(.created_at)\(if .in_reply_to_id then " (reply)" else "" end)\n\(.body)\n"'
  echo "## PR comments"
  gh api "repos/$nwo/issues/$num/comments" --paginate | jq -r --arg me "$me" '
    .[] | select((.user.login == $me and (.body | startswith("### AI Slop Score:"))
                 and (.body | test("<!-- llm-brain:ai-slop-score -->\\s*$"))) | not)
    | "### \(.user.login) at \(.created_at)\n\(.body)\n"'
}

# AI Slop Score of one PR head, scored in its clone. Sets SLOP (the review section) and SLOP_VERDICT for the prompt,
# keeps each score in $BRAIN_STATE/slop/<key>/ so a re-review can say what changed, and sets the commit status.
slop_for() { # slop_for <pr-url> <key> <head-sha> <base-branch> <dir with src/>
  local url="$1" key="$2" sha="$3" base="$4" dir="$5" hist prev args=()
  SLOP="(AI Slop Score is off for this fleet.)"; SLOP_VERDICT="off"
  [[ "$(cfg '.slop.enabled')" == "true" ]] || return 0
  hist="$BRAIN_STATE/slop/$key"; mkdir -p "$hist"
  prev="$(ls -t "$hist"/*.json 2>/dev/null | grep -v "/$sha.json" | head -1 || true)"   # markers (.shown/.pending) aren't .json
  [[ -n "$prev" ]] && args+=(--previous "$prev")
  [[ "$(cfg '.slop.post_status')" == "true" && "$(cfg '.pr_review.post')" == "true" ]] && args+=(--post-status)
  (cd "$dir/src" && "$BRAIN_DIR/bin/slop-score" --base "origin/$base" --pr "$url" --out-dir "$dir/slop" ${args[@]+"${args[@]}"} \
    >/dev/null 2>>"$dir/slop.err") || true
  if [[ -f "$dir/slop/slop.json" ]]; then
    cp "$dir/slop/slop.json" "$hist/$sha.json"
    SLOP="$(cat "$dir/slop/slop.md")"; SLOP_VERDICT="$(jq -r .verdict "$dir/slop/slop.json")"
    log "$key: AI Slop Score $(jq -r .score "$dir/slop/slop.json")/100 ($SLOP_VERDICT)"
  else
    SLOP="(AI Slop Score could not run: $(tail -1 "$dir/slop.err" 2>/dev/null))"; SLOP_VERDICT="error"
    log "$key: slop-score failed: $(tail -1 "$dir/slop.err" 2>/dev/null)"
  fi
}

# Score a PR's current head without an LLM and show it on the PR: one comment, edited in place on each new head,
# plus the ai-slop-score commit status. For PRs that get no review on this head (the fleet's own; ones reviewed
# before the score existed). Does nothing when that head is already scored.
slop_publish() { # slop_publish <pr-url> [force]
  local url="$1" force="${2:-}" nwo num key sha base dir cid me post
  [[ "$(cfg '.slop.enabled')" == "true" ]] || return 0
  [[ "$url" =~ ^https://github.com/([^/]+/[^/]+)/pull/([0-9]+) ]] || return 0
  nwo="${BASH_REMATCH[1]}"; num="${BASH_REMATCH[2]}"; key="review-${nwo#*/}-$num"
  sha="$(gh pr view "$url" --json headRefOid --jq .headRefOid)" || return 0
  post="$(cfg '.pr_review.post')"
  # done = shown on the PR (or scored, on a dry run); a score that failed to post is retried next tick
  [[ -z "$force" && -f "$BRAIN_STATE/slop/$key/$sha.$([[ "$post" == "true" ]] && echo shown || echo json)" ]] && return 0
  base="$(gh pr view "$url" --json baseRefName --jq .baseRefName)"
  dir="$(mktemp -d "$BRAIN_STATE/slop-run.XXXXXX")"
  if git clone -q --filter=blob:none --no-checkout "git@github.com:$nwo.git" "$dir/src" \
     && git -C "$dir/src" fetch -q origin "pull/$num/head" "$base:refs/remotes/origin/$base" && git -C "$dir/src" checkout -q --detach "$sha"; then
    slop_for "$url" "$key" "$sha" "$base" "$dir"
    if [[ "$SLOP_VERDICT" != "error" && "$SLOP_VERDICT" != "off" && "$post" == "true" ]]; then
      touch "$BRAIN_STATE/slop/$key/$sha.pending"
      printf '%s\n\n<!-- llm-brain:ai-slop-score -->\n' "$SLOP" >"$dir/comment.md"
      # our own marker comment only (never someone's quote of it); a failed lookup must not become a duplicate
      if me="$(gh api user --jq .login)" && cid="$(gh api "repos/$nwo/issues/$num/comments" --paginate --jq \
           ".[] | select(.user.login == \"$me\" and (.body | contains(\"<!-- llm-brain:ai-slop-score -->\"))) | .id")"; then
        cid="$(tail -1 <<<"$cid")"
        if { [[ -n "$cid" ]] && gh api -X PATCH "repos/$nwo/issues/comments/$cid" -F body=@"$dir/comment.md" >/dev/null; } \
           || { [[ -z "$cid" ]] && gh api "repos/$nwo/issues/$num/comments" -F body=@"$dir/comment.md" >/dev/null; }; then
          touch "$BRAIN_STATE/slop/$key/$sha.shown"; rm -f "$BRAIN_STATE/slop/$key/$sha.pending"
          log "$key: AI Slop Score shown on $url"
        else
          log "$key: could not post the slop comment on $url; retrying next tick"
        fi
      else
        log "$key: could not read the comments on $url; retrying next tick"
      fi
    fi
  else
    log "slop: clone failed for $url"
  fi
  rm -rf "$dir"
}

cmd_slop() { # fleet slop <pr-url> [--post]
  local url="${1:?usage: fleet slop <pr-url> [--post]}" post="${2:-}" dir nwo num base
  [[ "$post" == "--post" ]] && { slop_publish "$url" force; return; }   # score it, comment, set the status
  [[ "$url" =~ ^https://github.com/([^/]+/[^/]+)/pull/([0-9]+) ]] || die "not a PR url: $url"
  nwo="${BASH_REMATCH[1]}"; num="${BASH_REMATCH[2]}"
  dir="$(mktemp -d "$BRAIN_STATE/slop-run.XXXXXX")"
  gh pr view "$url" --json baseRefName,state,mergeCommit >"$dir/pr.json"
  base="$(jq -r .baseRefName "$dir/pr.json")"
  # pull/N/head exists for merged PRs (branch deleted) and forks alike
  git clone -q --filter=blob:none --no-checkout "git@github.com:$nwo.git" "$dir/src" \
    && git -C "$dir/src" fetch -q origin "pull/$num/head:refs/slop/head" "$base:refs/remotes/origin/$base" \
    && git -C "$dir/src" checkout -q --detach refs/slop/head || { rm -rf "$dir"; die "clone failed for $url"; }
  local against="origin/$base" mc
  mc="$(jq -r '.mergeCommit.oid // empty' "$dir/pr.json")"
  # a merged PR's head is inside its base branch; compare with the base as it was just before the merge
  [[ "$(jq -r .state "$dir/pr.json")" == "MERGED" && -n "$mc" ]] && against="$mc^1"
  (cd "$dir/src" && "$BRAIN_DIR/bin/slop-score" --base "$against" --pr "$url" ${post:+--post-status}) || true
  rm -rf "$dir"
}

post_mode() {
  if [[ "$(cfg '.pr_review.post')" == "true" ]]; then
    echo "POST the review to GitHub as described below."
  else
    echo "DRY RUN: do NOT post anything to GitHub. Write the exact JSON body you would send to the reviews API to $1/review.json, and the rendered review (body + each inline comment with path:line) as markdown to $1/review.md."
  fi
}

cmd_review_prs() {
  paused && { log "paused"; return; }
  [[ "$(cfg '.pr_review.enabled')" == "true" ]] || return 0
  local url key sha last dir pf nwo base num prior lf fails scope chat_repo chat_num chat_token chat_seen feedback_only backfilled=0 queue
  queue="${ONLY_PR:-}"
  if [[ -z "$queue" ]]; then queue="$(review_queue)" || return 1; fi
  for url in $queue; do
    key="review-$(sed -E 's#https://github.com/[^/]+/([^/]+)/pull/([0-9]+)#\1-\2#' <<<"$url")"
    worker_running "$key" && continue
    # never review my own PRs (the queue filters them too; this covers `review-pr <url>`)
    [[ "$(gh pr view "$url" --json author --jq .author.login)" == "$(cfg '.owner.github')" ]] && { log "$url is mine — not reviewing"; continue; }
    sha="$(gh pr view "$url" --json headRefOid --jq .headRefOid)"
    last="$(cat "$BRAIN_STATE/prs/$key.reviewed" 2>/dev/null || true)"
    chat_repo="${url#https://github.com/}"; chat_repo="${chat_repo%/pull/*}"; chat_num="${url##*/}"
    chat_token="$(cat "$BRAIN_STATE/chat/review-requests/${chat_repo/\//__}__${chat_num}.sha256" 2>/dev/null || true)"
    chat_seen="$(cat "$BRAIN_STATE/prs/$key.chat-reviewed" 2>/dev/null || true)"
    feedback_only=false
    if [[ "$sha" == "$last" ]]; then                        # one review per head commit…
      lf="$(ls -t "$BRAIN_STATE/logs/$key".*.log 2>/dev/null | head -1)"
      fails="$(cat "$BRAIN_STATE/prs/$key.fails" 2>/dev/null || echo 0)"
      if [[ -n "$lf" ]] && grep -q '^BUDGET_STOPPED ' "$lf"; then
        log "$key: resource budget stopped this review — needs a human handoff, not an automatic retry"
        continue
      fi
      if [[ -n "$chat_token" && "$chat_token" != "$chat_seen" ]]; then
        feedback_only=true
        log "$key: new trusted Slack request — bounded feedback pass on the same head"
      elif [[ -n "$lf" ]] && ! grep -q '^REVIEWED ' "$lf" && (( fails < 3 )); then
        echo $((fails + 1)) >"$BRAIN_STATE/prs/$key.fails"  # …unless that review died without posting
        log "$key: last review produced no result — retry $((fails + 1))/3"
      else
        # reviewed before the slop score existed: score it and show it as a comment, a few PRs per tick
        if [[ ! -f "$BRAIN_STATE/slop/$key/$sha.json" || -f "$BRAIN_STATE/slop/$key/$sha.pending" ]] && (( backfilled < $(cfg '.slop.backfill_per_tick // 3') )); then
          backfilled=$((backfilled + 1)); slop_publish "$url" || true
        fi
        continue
      fi
    else
      rm -f "$BRAIN_STATE/prs/$key.fails"
    fi
    (( $(review_capacity_left) > 0 )) || { log "review pool full"; return; }
    dir="$BRAIN_STATE/reviews/$key"; rm -rf "$dir"; mkdir -p "$dir"
    gh pr view "$url" --json headRepository,headRepositoryOwner,headRefName,baseRefName,number >"$dir/pr.json"
    nwo="$(jq -r '.headRepositoryOwner.login + "/" + .headRepository.name' "$dir/pr.json")"
    base="$(jq -r .baseRefName "$dir/pr.json")"; num="$(jq -r .number "$dir/pr.json")"
    git clone -q --filter=blob:none --branch "$(jq -r .headRefName "$dir/pr.json")" "git@github.com:$nwo.git" "$dir/src" \
      && git -C "$dir/src" fetch -q origin "$base:refs/remotes/origin/$base" || { log "clone failed for $url"; continue; }
    existing_feedback "$nwo" "$num" >"$dir/existing.md"
    slop_for "$url" "$key" "$sha" "$base" "$dir"
    prior=""; scope="origin/$base"
    lf="$(ls -t "$BRAIN_STATE/logs/$key".*.log 2>/dev/null | head -1 || true)"
    if [[ "$feedback_only" == true && -n "$lf" ]] && grep -q '^REVIEWED ' "$lf"; then
      scope="$sha"
      prior="SAME-HEAD SLACK FOLLOW-UP. There is no new code delta. Read the trusted Slack instructions, inspect only their directly relevant code/contracts and review readiness, and report new unresolved points. Do not repeat a full review or merge/deploy anything."
    elif [[ -n "$last" && "$last" != "$sha" && -n "$lf" ]] && grep -q '^REVIEWED ' "$lf" \
       && git -C "$dir/src" merge-base --is-ancestor "$last" HEAD 2>/dev/null; then
      scope="$last"
      prior="This is a RE-REVIEW of changes since ${last:0:8}. Review only that delta plus directly affected code and whether earlier findings were resolved. Do not repeat a full unchanged-file review."
    fi
    pf="$dir/prompt.md"
    prompt_env pr-review
    NOTES="$(notes_for "$chat_repo#$chat_num")" PR_URL="$url" HOST="$HOST_NAME" BRAIN_DIR="$BRAIN_DIR" HEAD_SHA="$sha" BASE="origin/$base" REVIEW_BASE="$scope" NWO="$nwo" NUMBER="$num" PRIOR="$prior" EXISTING="$dir/existing.md" POST_MODE="$(post_mode "$dir")" SLOP="$SLOP" SLOP_VERDICT="$SLOP_VERDICT" \
      render "$BRAIN_DIR/prompts/pr-review.md" >"$pf"
    echo "$sha" >"$BRAIN_STATE/prs/$key.reviewed"
    printf '%s\n' "$chat_token" >"$BRAIN_STATE/prs/$key.chat-reviewed"
    LLM_MODEL="$(cfg '.pr_review.model // ""')" BRAIN_REPO="$nwo" BRAIN_PR="$num" SPAWN_CWD="$dir/src" spawn "$key" "$(cfg '.pr_review.provider')" write "$(cfg '.limits.review_timeout')" "$pf"
  done
}

# Snapshot for the dashboard: everything it shows, so the web server never calls GitHub.
cmd_snapshot() {
  local tmp="$BRAIN_STATE/status.json.tmp" workers=() f k pid lf
  for f in "$BRAIN_STATE"/runs/*.pid; do
    [[ -e "$f" ]] || continue
    k="$(basename "$f" .pid)"; pid="$(cat "$f")"
    kill -0 "$pid" 2>/dev/null || continue
    lf="$(ls -t "$BRAIN_STATE/logs/$k".*.log 2>/dev/null | head -1)"
    workers+=("$(jq -nc --arg k "$k" --arg pid "$pid" --arg log "$(basename "${lf:-}")" \
      --arg since "$(stat -f %Sm -t '%Y-%m-%dT%H:%M:%S' "$f")" '{key:$k,pid:$pid,log:$log,since:$since}')")
  done
  local owned queue prs reviews
  owned="$(for repo in $(cfg '.intake.repos[]'); do
      gh issue list -R "$repo" --state open --assignee "$(cfg '.intake.assignee')" \
        --search "label:\"$(cfg '.labels.claimed')\",\"$(cfg '.labels.pr_open')\",\"$(cfg '.labels.blocked')\"" \
        --json number,title,url,labels,author,updatedAt; done | jq -s 'add // []')"
  queue="$(intake_queue | while read -r r n; do
      gh issue view "$n" -R "$r" --json number,title,url,author,createdAt \
        | jq -c --argjson hand "$(has_my_open_pr "$n" && echo true || echo false)" '. + {by_hand:$hand}'; done | jq -s '.')"
  prs="$(fleet_prs | jq -c '.[]' | while read -r row; do
      gh pr view "$(jq -r .url <<<"$row")" --json url,title,number,headRefName,reviewDecision,mergeStateStatus,statusCheckRollup,updatedAt \
        | jq -c '{url,title,number,reviewDecision,mergeStateStatus,updatedAt,
                  ci: ([.statusCheckRollup[]? | (.conclusion // .state // .status)] | if length==0 then "none"
                       elif any(.=="FAILURE" or .=="ERROR" or .=="TIMED_OUT") then "failing"
                       elif any(.=="IN_PROGRESS" or .=="QUEUED" or .=="PENDING" or .=="EXPECTED") then "running" else "passing" end)}'
    done | jq -s '.')"
  reviews="$(for lf in $(ls -t "$BRAIN_STATE"/logs/review-*.log 2>/dev/null | head -40); do
      line="$(grep -m1 '^REVIEWED ' "$lf" || true)"
      jq -nc --arg log "$(basename "$lf")" --arg line "$line" --arg at "$(stat -f %Sm -t '%Y-%m-%dT%H:%M:%S' "$lf")" \
        '{log:$log, at:$at, url:($line|split(" ")[1] // null), verdict:($line|split(" ")[2] // "running/failed"),
          detail:($line|split(" ")[3:]|join(" "))}'
    done | jq -s '.')"
  jq -n --arg host "$HOST" --arg at "$(date '+%Y-%m-%dT%H:%M:%S')" --argjson paused "$(paused && echo true || echo false)" \
    --arg impl "$(implementer)" --arg rev "$(reviewer)" --arg prov "$(cfg '.pr_review.provider')" \
    --argjson max "$(cfg '.intake.max_in_flight')" --argjson owned "$owned" --argjson queue "$queue" \
    --argjson prs "$prs" --argjson reviews "$reviews" \
    --argjson workers "$(printf '%s\n' "${workers[@]+"${workers[@]}"}" | jq -s '.')" \
    --arg tail "$(tail -40 "$BRAIN_STATE/logs/fleet.log" 2>/dev/null)" \
    --argjson chat "$(cat "$BRAIN_STATE/chat/digest.json" 2>/dev/null || echo null)" \
    '{host:$host, at:$at, paused:$paused, roles:{implementer:$impl, internal_reviewer:$rev, pr_reviewer:$prov},
      max_in_flight:$max, owned:$owned, queue:$queue, prs:$prs, reviews:$reviews, workers:$workers, log:$tail, chat:$chat}' >"$tmp"
  mv "$tmp" "$BRAIN_STATE/status.json"
}

cmd_status() {
  echo "host: $HOST_NAME ($HOST)   paused: $(paused && echo yes || echo no)   implementer: $(implementer)   reviewer: $(reviewer)"
  echo "workers: $(running_workers)/$(cfg '.limits.max_workers')"
  for f in "$BRAIN_STATE"/runs/*.pid; do [[ -e "$f" ]] && echo "  - $(basename "$f" .pid) (pid $(cat "$f"))"; done
  echo; echo "claimed issues:"
  for repo in $(cfg '.intake.repos[]'); do
    gh issue list -R "$repo" --state open --label "$(cfg '.labels.claimed')" --json number,title,labels \
      --jq '.[] | "  #\(.number) \(.title)  [\([.labels[].name | select(startswith("agent"))] | join(","))]"'
  done
  echo; echo "fleet PRs:"
  fleet_prs | jq -r '.[] | "  \(.url)  (updated \(.updatedAt))"'
}

cmd_labels() {
  local repo
  for repo in $(cfg '.intake.repos[]'); do
    gh label create "$(cfg '.intake.label')" -R "$repo" --color 0E8A16 --description "Opt-in: the llm-brain agent fleet may implement this issue" --force
    gh label create "$(cfg '.labels.claimed')" -R "$repo" --color FBCA04 --description "llm-brain fleet is implementing this" --force
    gh label create "$(cfg '.labels.pr_open')" -R "$repo" --color 1D76DB --description "llm-brain fleet has a PR open for this" --force
    gh label create "$(cfg '.labels.blocked')" -R "$repo" --color D93F0B --description "llm-brain fleet needs a human decision" --force
    gh label create "$(cfg '.labels.stop')" -R "$repo" --color 000000 --description "llm-brain fleet must not touch this" --force
    gh label create "$(cfg '.labels.done')" -R "$repo" --color C5DEF5 --description "llm-brain fleet: nothing left to build; needs a human/UAT check" --force
  done
}

case "${1:-}" in
  tick)
    # One tick at a time on this machine: a slow tick (a long chat digest) must not overlap the next one,
    # or both dispatch the same issue. A lock whose owner is gone is taken over.
    lock="$BRAIN_STATE/tick.lock"
    if ! mkdir "$lock" 2>/dev/null; then
      # Held by a live fleet process (not a recycled pid), and not for over an hour (ticks take minutes).
      lp="$(cat "$lock/pid" 2>/dev/null)"
      if [[ -n "$lp" ]] && ps -p "$lp" -o command= 2>/dev/null | grep -q "bin/fleet" &&
         [[ -z "$(find "$lock" -maxdepth 0 -mmin +60 2>/dev/null)" ]]; then
        log "tick: previous tick still running — skipping"; exit 0
      fi
      rm -rf "$lock"; mkdir "$lock" || exit 0
    fi
    echo $$ >"$lock/pid"
    trap 'rm -rf "$lock"' EXIT
    log "tick"; "$BRAIN_DIR/bin/chat-watch" 2>>"$BRAIN_STATE/logs/fleet.log" || true; cmd_dispatch || true; cmd_babysit || true; cmd_review_prs || true; cmd_snapshot ;;
  snapshot) cmd_snapshot ;;
  review-prs) cmd_review_prs ;;
  review-pr) shift; ONLY_PR="$1" cmd_review_prs ;;
  dispatch) cmd_dispatch ;;
  babysit) cmd_babysit ;;
  review) shift; cmd_review "$@" ;;
  slop) shift; cmd_slop "$@" ;;
  status) cmd_status ;;
  prs) fleet_prs | jq . ;;
  labels) cmd_labels ;;
  pause) touch "$BRAIN_LOCAL/PAUSE"; log "paused $HOST" ;;
  resume) rm -f "$BRAIN_LOCAL/PAUSE"; log "resumed $HOST" ;;
  providers) echo "available: $(available_providers | tr '\n' ' ')"; echo "implementer: $(implementer)"; echo "reviewer: $(reviewer)" ;;
  *) sed -n '2,14p' "$0"; exit 1 ;;
esac
