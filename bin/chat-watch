#!/usr/bin/env python3
"""chat-watch [--dry-run]

Acts on team chat. The hub holds the Slack connection (token, watched channels, DMs, mentions; see
/settings/slack) and stores every message; this reads the new ones from the hub's API every fleet tick.
  - from `chat.trusted` -> a note on each issue/PR it mentions (notes/<owner>__<repo>__<n>.md);
                          implement/babysit workers get those notes as instructions, like review comments
  - new messages       -> one LLM pass (prompts/chat-insights.md): a short digest for the hub and
                          actions. Today the only action is `stop`: label agent:stop on a fleet issue
                          and kill its worker (e.g. "stand down on #840, someone else is taking it").
It never posts anywhere in chat.
"""
import argparse, hashlib, json, os, re, signal, subprocess, sys, tempfile, urllib.request
from datetime import datetime
from pathlib import Path

BRAIN = Path(__file__).resolve().parent.parent
STATE = Path(os.environ.get("BRAIN_STATE", Path.home() / ".local/state/llm-brain"))
CHAT = STATE / "chat"
NOTES = STATE / "notes"
LOGS = STATE / "logs"
HOST = os.uname().nodename.split(".")[0]


def sh(cmd):
    return subprocess.run(["bash", "-c", f'source "{BRAIN}/bin/lib.sh"; {cmd}'], capture_output=True, text=True,
                          env=dict(os.environ, BRAIN_DIR=str(BRAIN))).stdout


def cfg(expr):
    try:
        return json.loads(sh(f"cfg -o=json '{expr}'") or "null")
    except json.JSONDecodeError:
        return None


def log(msg):
    print(f"{datetime.now():%Y-%m-%d %H:%M:%S} [{HOST}] chat: {msg}", file=sys.stderr)


# ---------------------------------------------------------------- refs -> notes

def known_repos():
    """owner/name of every repo we know: chat.repos, intake repos, the overlay's repos.txt."""
    repos = set(cfg(".chat.repos") or []) | set(cfg(".intake.repos") or [])
    ov = sh("overlay_dir").strip()
    if ov and Path(ov, "repos.txt").exists():
        for line in Path(ov, "repos.txt").read_text().splitlines():
            m = re.search(r"github\.com[:/]([\w.-]+)/([\w.-]+?)(?:\.git)?\s*$", line)
            if m:
                repos.add(f"{m.group(1)}/{m.group(2)}")
    return sorted(repos)


def resolve(short, repos):
    """'api' -> acme/web-api; exact name, then suffix, then substring; require a unique match."""
    s = short.lower()
    for test in (lambda n: n == s, lambda n: n.endswith("-" + s), lambda n: s in n):
        hits = sorted((r for r in repos if test(r.split("/")[1].lower())), key=len)
        if hits:
            return hits[0] if len(hits) == 1 else None
    return None


def refs(text, default_repo, repos, learned=None):
    """Resolve explicit refs first; learned bare-number mappings are scoped to one thread."""
    learned = {} if learned is None else learned
    out = set()
    for o, n, num in re.findall(r"github\.com/([\w.-]+)/([\w.-]+)/(?:issues|pull)/(\d+)", text):
        out.add((f"{o}/{n}", int(num)))
    body = re.sub(r"https?://\S+", " ", text)
    def qualified(match):
        prefix, gap, num = match.groups()
        if "/" in prefix:
            repo = prefix if prefix in repos else None
        elif gap:
            # "SDK #99" is useful; ordinary words like "on #99" are not repo aliases.
            matches = [r for r in repos if r.split("/")[1].lower() == prefix.lower()
                       or r.split("/")[1].lower().endswith("-" + prefix.lower())]
            repo = matches[0] if len(matches) == 1 else None
        else:
            repo = resolve(prefix, repos)
        if repo:
            out.add((repo, int(num)))
            return " "
        return match.group(0)
    body = re.sub(r"(?<![\w/])([A-Za-z][\w.-]*(?:/[\w.-]+)?)([ \t]*)#(\d+)", qualified, body)
    for number in {str(n) for _, n in out}:
        matches = {r for r, n in out if str(n) == number}
        if len(matches) == 1:
            learned[number] = next(iter(matches))
        else:
            learned.pop(number, None)
    def expand_range(match):
        first, last = map(int, match.groups())
        return " ".join(f"#{n}" for n in range(first, last + 1)) if 0 <= last - first <= 20 else match.group(0)
    body = re.sub(r"#(\d+)\s*[-–]\s*#?(\d+)", expand_range, body)
    for num in re.findall(r"(?<![\w#-])#(\d+)\b", body):
        repo = learned.get(num) or default_repo
        if repo:
            out.add((repo, int(num)))
    return out


def note_path(repo, num):
    return NOTES / f"{repo.replace('/', '__')}__{num}.md"


# Identity aliases describe the addressee; only authenticated sender IDs grant authority.
def addressed_to_owner(text, aliases):
    return any(re.search(r"(?<![\w])" + re.escape(alias) + r"(?![\w])", text, re.I)
               for alias in aliases if alias)


def target_kind(repo, number):
    """GitHub issues endpoints include PRs: verify the object, never guess by number."""
    try:
        result = subprocess.run(["gh", "api", f"repos/{repo}/issues/{number}"], capture_output=True, text=True, timeout=20)
    except subprocess.TimeoutExpired:
        return "unknown"
    if result.returncode:
        return "unknown"
    try:
        obj = json.loads(result.stdout)
        if not isinstance(obj, dict):
            return "unknown"
        return "review" if "pull_request" in obj else "task" if obj.get("number") == number else "unknown"
    except json.JSONDecodeError:
        return "unknown"


def review_requested(text):
    # Status-only chatter stays in context/digest; it must not buy another full review.
    return bool(re.search(
        r"\b(?:please|could you|can you|would you)\s+(?:(?:re[- ]?)?(?:review|check|score|run)|look|verify|merge|address|fix)\b"
        r"|(?im:^[ \t]*(?:re[- ]?review|re[- ]?score|review|check|score|verify|merge|address|fix)\b)", text, re.I))


def prepare_messages(rows, me, trusted, people, channel_repos, repos, st, aliases, owner, lookup=target_kind):
    """Pure routing except the injected GitHub type lookup. No task or review is launched here."""
    new, kinds = [], {}
    scoped = st.setdefault("scoped_refs", {})
    threads = st.setdefault("thread_refs", {})
    for m in rows:
        uid = m.get("user_id", "")
        is_owner = bool(uid and uid == (me.get("owner_id") or me.get("user_id")))
        authorized = is_owner or uid in trusted
        text = m.get("text", "")
        conv = m.get("conv_id") or m.get("conv_name", "")
        thread = m.get("thread_ts") or m.get("ts", "")
        scope = conv + "/" + thread
        # Never let another sender's bare number poison a trusted instruction's mapping.
        learned = dict(scoped.get(scope, {}))
        found = refs(text, channel_repos.get(conv) or channel_repos.get(m.get("conv_name", "")), repos, learned)
        if not found and m.get("thread_ts"):
            found = {(r, int(n)) for r, n in threads.get(scope, [])}
        if authorized:
            scoped[scope] = learned
            if found:
                threads[scope] = sorted(found)
        targets = []
        for repo, number in sorted(found):
            ref = f"{repo}#{number}"
            if authorized and ref not in kinds:
                kinds[ref] = lookup(repo, number)
            targets.append({"ref": ref, "kind": kinds.get(ref, "context")})
        new.append({
            "id": m.get("id"), "source_id": conv + "/" + m.get("ts", str(m.get("id", ""))),
            "at": (m.get("at") or "")[:19].replace("T", " "),
            "where": m.get("conv_name") or m.get("conv_kind"), "kind": m.get("conv_kind"),
            "who": owner if is_owner else people.get(trusted.get(uid)) or m.get("user_name") or uid,
            "sender_id": uid, "owner": is_owner, "trusted": authorized,
            "to_me": bool(m.get("mentions_me")) or m.get("conv_kind") in ("dm", "group_dm") or addressed_to_owner(text, aliases),
            "thread": bool(m.get("thread_ts")) and m.get("thread_ts") != m.get("ts"),
            "text": text, "link": m.get("permalink", ""),
            "refs": [t["ref"] for t in targets], "targets": targets,
            "review_requested": authorized and review_requested(text),
        })
    # Bound thread metadata; notes retain the original instructions and source links.
    for mapping in (scoped, threads):
        for key in list(mapping)[:-1000]:
            del mapping[key]
    return new


def atomic_json(path, value):
    fd, temp = tempfile.mkstemp(dir=path.parent)
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(value, f, indent=1)
        os.replace(temp, path)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)


def save_messages(new, st):
    receipts = st.setdefault("routes", {})
    history = st.setdefault("review_requests", {})
    request_dir = CHAT / "review-requests"
    request_dir.mkdir(parents=True, exist_ok=True)
    for m in new:
        if not m["trusted"]:
            continue
        for target in m["targets"]:
            repo, num = target["ref"].rsplit("#", 1)
            path = note_path(repo, int(num))
            marker = "<!-- llm-brain:slack-message:" + m["source_id"] + " -->"
            existing = path.read_text() if path.exists() else ""
            if marker not in existing:
                header = f"### {m['at']} — {m['who']} in {m['where']}\n"
                legacy = header + m['text'] + "\n\n"
                entry = (f"{marker}\n{header}Source: {m['link'] or m['source_id']} · "
                         f"sender {m['sender_id']} · route {target['kind']}\n{m['text']}\n\n")
                if legacy in existing:
                    path.write_text(existing.replace(legacy, entry, 1))
                else:
                    with path.open("a") as f:
                        f.write(entry)
            if target["kind"] == "review" and m["review_requested"]:
                digest = hashlib.sha256(re.sub(r"\s+", " ", m["text"]).strip().encode()).hexdigest()
                seen = history.setdefault(target["ref"], [])
                if digest not in seen:
                    seen.append(digest)
                    del seen[:-50]
                token = hashlib.sha256("\n".join(seen).encode()).hexdigest()
                # Same content received again keeps the token unchanged, including after replay.
                request_dir.joinpath(path.stem + ".sha256").write_text(token + "\n")
                atomic_json(request_dir / (path.stem + ".json"), {
                    "url": f"https://github.com/{repo}/pull/{num}", "token": token,
                    "source": m["link"] or m["source_id"]})
        status = "needs_resolution" if any(t["kind"] == "unknown" for t in m["targets"]) else "routed" if m["targets"] else "needs_reference"
        receipts[str(m["id"])] = {"source": m["link"] or m["source_id"], "sender": m["sender_id"],
            "targets": m["targets"], "state": status}
    for key in list(receipts)[:-1000]:
        del receipts[key]


# ---------------------------------------------------------------- main

def hub_get(path):
    base = (cfg(".chat.hub_url") or "http://127.0.0.1:8787").rstrip("/")
    with urllib.request.urlopen(base + path, timeout=30) as r:
        return json.load(r)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--dry-run", action="store_true", help="print what's new; write nothing, act on nothing")
    ap.add_argument("--replay-channel", metavar="ID", help="re-route stored messages from this channel without advancing the cursor or running insights")
    a = ap.parse_args()
    if not cfg(".chat.enabled") and not a.dry_run:
        return
    for d in (CHAT, NOTES, LOGS):
        d.mkdir(parents=True, exist_ok=True)
    sf = CHAT / "state.json"
    st = json.loads(sf.read_text()) if sf.exists() else {}
    trusted = cfg(".chat.trusted") or {}
    people = cfg(".people") or {}
    channel_repos = cfg(".chat.channel_repos") or {}
    repos = known_repos()
    owner = cfg(".owner.name") or "owner"
    aliases = [owner, cfg(".owner.github") or "", *(cfg(".owner.aliases") or [])]
    try:
        me = hub_get("/api/chat/me")
        me["owner_id"] = cfg(".owner.slack_user_id") or me.get("user_id")
        if a.replay_channel:
            rows, after = [], 0
            while True:
                batch = hub_get(f"/api/chat/messages?after={after}&limit=5000")
                batch = batch.get("messages", batch) if isinstance(batch, dict) else batch
                rows.extend(m for m in batch if m.get("conv_id") == a.replay_channel)
                if len(batch) < 5000:
                    break
                after = max(int(m["id"]) for m in batch)
        else:
            rows = hub_get(f"/api/chat/messages?after={st.get('after', 0)}&limit=500")
    except Exception as e:
        log(f"hub unreachable or chat not connected: {e}")
        return
    rows = rows.get("messages", rows) if isinstance(rows, dict) else rows
    new = prepare_messages(rows, me, trusted, people, channel_repos, repos, st,
                           aliases + [me.get("user_name", "")], owner)
    if a.dry_run:
        print(json.dumps(new, indent=1))
        return
    save_messages(new, st)
    if rows and not a.replay_channel:
        st["after"] = max(int(m["id"]) for m in rows)
    atomic_json(sf, st)
    log(f"{len(new)} new message(s), {sum(m['trusted'] for m in new)} from trusted people")
    if new and not a.replay_channel and cfg(".chat.insights"):
        insights(new[-200:])


def insights(new):
    run = datetime.now().strftime("%Y%m%d-%H%M%S")
    work = CHAT / "runs" / run
    work.mkdir(parents=True, exist_ok=True)
    status = STATE / "status.json"
    st = json.loads(status.read_text()) if status.exists() else {}
    fleet = {"owned": [{"url": i.get("url"), "title": i.get("title")} for i in st.get("owned", [])],
             "prs": [{"url": p.get("url"), "title": p.get("title")} for p in st.get("prs", [])]}
    (work / "messages.json").write_text(json.dumps(new, indent=1))
    (work / "fleet.json").write_text(json.dumps(fleet, indent=1))
    prev = CHAT / "digest.json"
    env = dict(os.environ, BRAIN_DIR=str(BRAIN), MESSAGES=json.dumps(new, indent=1), FLEET=json.dumps(fleet, indent=1),
               PREV_DIGEST=(json.loads(prev.read_text()).get("digest", "") if prev.exists() else "(none)"))
    pf = work / "prompt.md"
    pf.write_text(subprocess.run(["bash", "-c", f'source "{BRAIN}/bin/lib.sh"; prompt_env chat-insights; render "{BRAIN}/prompts/chat-insights.md"'],
                                 capture_output=True, text=True, env=env).stdout)
    provider = cfg(".chat.provider") or "claude"
    logf = LOGS / f"chat-insights.{run}.log"
    with open(logf, "w") as out:
        subprocess.run(["gtimeout", "15m", str(BRAIN / "bin/llm-run"), provider, "review", str(work), str(pf), "llm-brain-chat"],
                       stdout=out, stderr=subprocess.STDOUT, env=dict(os.environ, LLM_MODEL=cfg(".chat.model") or ""))
    text = logf.read_text()
    m = re.search(r"^INSIGHTS (\{.*\})\s*$", text, re.M)
    if not m:
        log(f"insights: no INSIGHTS line (see {logf.name})")
        return
    try:
        res = json.loads(m.group(1))
    except json.JSONDecodeError:
        log(f"insights: bad JSON (see {logf.name})")
        return
    prev.write_text(json.dumps({"at": datetime.now().strftime("%Y-%m-%dT%H:%M:%S"), "digest": res.get("digest", ""),
                                "asks": res.get("asks", []), "log": logf.name}, indent=1))
    for act in res.get("actions", []):
        if act.get("type") == "stop":
            stop(act)


def stop(act):
    """Only issues the fleet owns, and only on a trusted person's word (the prompt says so; we re-check ownership)."""
    repo, num = act.get("repo", ""), int(act.get("number") or 0)
    if not repo or not num:
        return
    labels = cfg("[.labels.claimed, .labels.pr_open]") or []
    have = subprocess.run(["gh", "issue", "view", str(num), "-R", repo, "--json", "labels", "--jq", "[.labels[].name]"],
                          capture_output=True, text=True).stdout
    if not any(l in (json.loads(have or "[]")) for l in labels):
        log(f"stop {repo}#{num}: not a fleet issue — ignoring")
        return
    subprocess.run(["gh", "issue", "edit", str(num), "-R", repo, "--add-label", cfg(".labels.stop")], capture_output=True)
    subprocess.run(["gh", "issue", "comment", str(num), "-R", repo, "--body",
                    f"🤖 llm-brain fleet: stopping here. {act.get('why', '')}".strip()], capture_output=True)
    pf = STATE / "runs" / f"issue-{num}.pid"
    if pf.exists():
        try:
            os.kill(int(pf.read_text()), signal.SIGTERM)
        except (ProcessLookupError, ValueError, PermissionError):
            pass
    log(f"stopped {repo}#{num}: {act.get('why', '')}")
    sh(f"notify {json.dumps(f'stopped {repo}#{num}: ' + act.get('why', ''))}")


if __name__ == "__main__":
    main()
