#!/usr/bin/env python3
"""chat-watch [--dry-run]

Acts on team chat. The hub holds the Slack connection (token, watched channels, DMs, mentions; see
/settings/slack) and stores every message; this reads the new ones from the hub's API every fleet tick.
  - from `chat.trusted` -> a note on each issue/PR it mentions (notes/<owner>__<repo>__<n>.md);
                          implement/babysit workers get those notes as instructions, like review comments
  - new messages       -> one LLM pass (prompts/chat-insights.md): a short digest for the hub and
                          actions. Today the only action is `stop`: label agent:stop on a fleet issue
                          and kill its worker (e.g. "stand down on #840, someone else is taking it").
It never posts anywhere in chat.
"""
import argparse, json, os, re, signal, subprocess, sys, urllib.request
from datetime import datetime
from pathlib import Path

BRAIN = Path(__file__).resolve().parent.parent
STATE = Path(os.environ.get("BRAIN_STATE", Path.home() / ".local/state/llm-brain"))
CHAT = STATE / "chat"
NOTES = STATE / "notes"
LOGS = STATE / "logs"
HOST = os.uname().nodename.split(".")[0]


def sh(cmd):
    return subprocess.run(["bash", "-c", f'source "{BRAIN}/bin/lib.sh"; {cmd}'], capture_output=True, text=True,
                          env=dict(os.environ, BRAIN_DIR=str(BRAIN))).stdout


def cfg(expr):
    try:
        return json.loads(sh(f"cfg -o=json '{expr}'") or "null")
    except json.JSONDecodeError:
        return None


def log(msg):
    print(f"{datetime.now():%Y-%m-%d %H:%M:%S} [{HOST}] chat: {msg}", file=sys.stderr)


# ---------------------------------------------------------------- refs -> notes

def known_repos():
    """owner/name of every repo we know: chat.repos, intake repos, the overlay's repos.txt."""
    repos = set(cfg(".chat.repos") or []) | set(cfg(".intake.repos") or [])
    ov = sh("overlay_dir").strip()
    if ov and Path(ov, "repos.txt").exists():
        for line in Path(ov, "repos.txt").read_text().splitlines():
            m = re.search(r"github\.com[:/]([\w.-]+)/([\w.-]+?)(?:\.git)?\s*$", line)
            if m:
                repos.add(f"{m.group(1)}/{m.group(2)}")
    return sorted(repos)


def resolve(short, repos):
    """'api' -> acme/web-api; fuzzy: exact name, then '-<short>' suffix, then substring; shortest wins."""
    s = short.lower()
    for test in (lambda n: n == s, lambda n: n.endswith("-" + s), lambda n: s in n):
        hits = sorted((r for r in repos if test(r.split("/")[1].lower())), key=len)
        if hits:
            return hits[0]
    return None


def refs(text, default_repo, repos, learned=None):
    """learned: number -> repo from earlier explicit refs, so a later bare #17446 means the same repo#17446."""
    learned = {} if learned is None else learned
    out = set()
    for o, n, num in re.findall(r"github\.com/([\w.-]+)/([\w.-]+)/(?:issues|pull)/(\d+)", text):
        out.add((f"{o}/{n}", int(num)))
    body = re.sub(r"https?://\S+", " ", text)
    for short, num in re.findall(r"(?<![\w/])([A-Za-z][\w.-]*)#(\d+)", body):
        r = resolve(short, repos)
        if r:
            out.add((r, int(num)))
    for r, n in out:
        learned[str(n)] = r
    for num in re.findall(r"(?<![\w/#-])#(\d+)\b", body):
        r = learned.get(num) or default_repo
        if r:
            out.add((r, int(num)))
    return out


def note_path(repo, num):
    return NOTES / f"{repo.replace('/', '__')}__{num}.md"


# ---------------------------------------------------------------- main

def hub_get(path):
    base = (cfg(".chat.hub_url") or "http://127.0.0.1:8787").rstrip("/")
    with urllib.request.urlopen(base + path, timeout=30) as r:
        return json.load(r)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--dry-run", action="store_true", help="print what's new; write nothing, act on nothing")
    a = ap.parse_args()
    if not cfg(".chat.enabled"):
        return
    for d in (CHAT, NOTES, LOGS):
        d.mkdir(parents=True, exist_ok=True)
    sf = CHAT / "state.json"
    st = json.loads(sf.read_text()) if sf.exists() else {}
    learned = st.setdefault("learned", {})
    trusted = cfg(".chat.trusted") or {}          # chat user id -> github handle
    people = cfg(".people") or {}                 # github handle -> display name
    channel_repos = cfg(".chat.channel_repos") or {}  # channel name -> what a bare #123 means there
    repos = known_repos()
    try:
        me = hub_get("/api/chat/me")
        rows = hub_get(f"/api/chat/messages?after={st.get('after', 0)}&limit=500")
    except Exception as e:
        log(f"hub unreachable or chat not connected: {e}")
        return
    rows = rows.get("messages", rows) if isinstance(rows, dict) else rows
    new = []
    for m in rows:
        uid = m.get("user_id", "")
        if uid and uid == me.get("user_id"):
            continue                                  # my own messages aren't news to me
        text = m.get("text", "")
        new.append({
            "at": (m.get("at") or "")[:19].replace("T", " "), "where": m.get("conv_name") or m.get("conv_kind"),
            "kind": m.get("conv_kind"), "who": people.get(trusted.get(uid)) or m.get("user_name") or uid,
            "trusted": uid in trusted, "to_me": bool(m.get("mentions_me")) or m.get("conv_kind") in ("dm", "group_dm"),
            "thread": bool(m.get("thread_ts")) and m.get("thread_ts") != m.get("ts"), "text": text,
            "link": m.get("permalink", ""),
            "refs": sorted(f"{r}#{n}" for r, n in refs(text, channel_repos.get(m.get("conv_name", "")), repos, learned)),
        })
    if rows:
        st["after"] = max(int(m["id"]) for m in rows)
    if a.dry_run:
        print(json.dumps(new, indent=1))
        return
    for m in new:
        if not m["trusted"]:
            continue
        for ref in m["refs"]:
            repo, num = ref.rsplit("#", 1)
            with open(note_path(repo, int(num)), "a") as f:
                f.write(f"### {m['at']} — {m['who']} in {m['where']}\n{m['text']}\n\n")
    sf.write_text(json.dumps(st, indent=1))
    log(f"{len(new)} new message(s), {sum(m['trusted'] for m in new)} from trusted people")
    if new and cfg(".chat.insights"):
        insights(new[-200:])


def insights(new):
    run = datetime.now().strftime("%Y%m%d-%H%M%S")
    work = CHAT / "runs" / run
    work.mkdir(parents=True, exist_ok=True)
    status = STATE / "status.json"
    st = json.loads(status.read_text()) if status.exists() else {}
    fleet = {"owned": [{"url": i.get("url"), "title": i.get("title")} for i in st.get("owned", [])],
             "prs": [{"url": p.get("url"), "title": p.get("title")} for p in st.get("prs", [])]}
    (work / "messages.json").write_text(json.dumps(new, indent=1))
    (work / "fleet.json").write_text(json.dumps(fleet, indent=1))
    prev = CHAT / "digest.json"
    env = dict(os.environ, BRAIN_DIR=str(BRAIN), MESSAGES=json.dumps(new, indent=1), FLEET=json.dumps(fleet, indent=1),
               PREV_DIGEST=(json.loads(prev.read_text()).get("digest", "") if prev.exists() else "(none)"))
    pf = work / "prompt.md"
    pf.write_text(subprocess.run(["bash", "-c", f'source "{BRAIN}/bin/lib.sh"; prompt_env chat-insights; render "{BRAIN}/prompts/chat-insights.md"'],
                                 capture_output=True, text=True, env=env).stdout)
    provider = cfg(".chat.provider") or "claude"
    logf = LOGS / f"chat-insights.{run}.log"
    with open(logf, "w") as out:
        subprocess.run(["gtimeout", "15m", str(BRAIN / "bin/llm-run"), provider, "review", str(work), str(pf), "llm-brain-chat"],
                       stdout=out, stderr=subprocess.STDOUT, env=dict(os.environ, LLM_MODEL=cfg(".chat.model") or ""))
    text = logf.read_text()
    m = re.search(r"^INSIGHTS (\{.*\})\s*$", text, re.M)
    if not m:
        log(f"insights: no INSIGHTS line (see {logf.name})")
        return
    try:
        res = json.loads(m.group(1))
    except json.JSONDecodeError:
        log(f"insights: bad JSON (see {logf.name})")
        return
    prev.write_text(json.dumps({"at": datetime.now().strftime("%Y-%m-%dT%H:%M:%S"), "digest": res.get("digest", ""),
                                "asks": res.get("asks", []), "log": logf.name}, indent=1))
    for act in res.get("actions", []):
        if act.get("type") == "stop":
            stop(act)


def stop(act):
    """Only issues the fleet owns, and only on a trusted person's word (the prompt says so; we re-check ownership)."""
    repo, num = act.get("repo", ""), int(act.get("number") or 0)
    if not repo or not num:
        return
    labels = cfg("[.labels.claimed, .labels.pr_open]") or []
    have = subprocess.run(["gh", "issue", "view", str(num), "-R", repo, "--json", "labels", "--jq", "[.labels[].name]"],
                          capture_output=True, text=True).stdout
    if not any(l in (json.loads(have or "[]")) for l in labels):
        log(f"stop {repo}#{num}: not a fleet issue — ignoring")
        return
    subprocess.run(["gh", "issue", "edit", str(num), "-R", repo, "--add-label", cfg(".labels.stop")], capture_output=True)
    subprocess.run(["gh", "issue", "comment", str(num), "-R", repo, "--body",
                    f"🤖 llm-brain fleet: stopping here. {act.get('why', '')}".strip()], capture_output=True)
    pf = STATE / "runs" / f"issue-{num}.pid"
    if pf.exists():
        try:
            os.kill(int(pf.read_text()), signal.SIGTERM)
        except (ProcessLookupError, ValueError, PermissionError):
            pass
    log(f"stopped {repo}#{num}: {act.get('why', '')}")
    sh(f"notify {json.dumps(f'stopped {repo}#{num}: ' + act.get('why', ''))}")


if __name__ == "__main__":
    main()
