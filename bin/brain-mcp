def validate(value, schema):
    kind=schema.get('type')
    if kind=='object':
        if not isinstance(value,dict) or any(k not in schema['properties'] for k in value) or any(k not in value for k in schema.get('required',[])):
            raise ValueError('Invalid tool arguments')
        for k,v in value.items():validate(v,schema['properties'][k])
    elif kind=='array':
        if not isinstance(value,list) or len(value)>schema.get('maxItems',50):raise ValueError('Invalid list')
        for v in value:validate(v,schema['items'])
    elif kind=='integer':
        if type(value) is not int or not schema.get('minimum',-10**12)<=value<=schema.get('maximum',10**12):raise ValueError('Invalid number')
    elif kind=='boolean':
        if type(value) is not bool:raise ValueError('Invalid boolean')
    elif kind=='string':
        if not isinstance(value,str) or len(value.encode())>schema.get('maxLength',65536) or ('enum' in schema and value not in schema['enum']):raise ValueError('Invalid text')

def native_crash_event(path):
    try:
        with path.open('rb') as source:
            lines = source.read(1048576).split(b'\n',3)
        event = json.loads(lines[2])
        images = event.get('debug_meta',{}).get('images',[])
        if any(image.get('code_file','').endswith('/Brain Hub.app/Contents/MacOS/BrainHub') for image in images):
            return event
    except (OSError,ValueError,IndexError,AttributeError):
        pass
    return None

def diagnostic_reports():
    roots = [Path.home()/'Library/Logs/BrainHub',
             Path.home()/'Library/Logs/DiagnosticReports',
             Path('/Library/Logs/DiagnosticReports'),
             Path.home()/'.local/state/ghostty/crash']
    found = {}
    for index, root in enumerate(roots):
        try:
            for path in root.iterdir():
                if path.is_symlink() or not path.is_file():
                    continue
                name = path.name
                allowed = (index == 0 and name in ('app.log','app.previous.log')) or (
                    index in (1,2) and path.suffix in ('.ips','.crash') and
                    (name.lower().startswith('brain') or name.startswith('hub-')))
                if index == 3 and path.suffix == '.ghosttycrash':
                    allowed = native_crash_event(path) is not None
                if allowed:
                    found[str(index)+'/'+name] = path
        except OSError:
            continue
    return found

def read_diagnostic(report):
    path = diagnostic_reports().get(report)
    if path is None:
        raise ValueError('Unknown diagnostic report')
    with path.open('rb') as source:
        raw = source.read(1048577)
    if path.suffix == '.ghosttycrash':
        event = native_crash_event(path)
        if event is None: raise ValueError('Invalid native crash envelope')
        text = json.dumps(event,indent=2)
    else:
        text = raw[:1048576].decode('utf-8',errors='replace')
    text = text.replace(str(Path.home()), '~')
    text = re.sub(r'(?i)(authorization[=: ]+bearer |api[_-]?key[=: ]+|token[=: ]+)[^\s",]+',
                  r'\1[REDACTED]', text)
    return {'report':report,'text':text,'truncated':len(raw)>1048576}

def desktop_update(action):
    """Control the installed local Mac app using its bundled, digest-verifying updater."""
    if sys.platform != 'darwin':
        raise ValueError('Desktop update through MCP currently requires the macOS app')
    bundle = Path('/Applications/Brain Hub.app')
    info = bundle / 'Contents/Info.plist'

    def installed_version():
        with info.open('rb') as source:
            metadata = plistlib.load(source)
        if metadata.get('CFBundleIdentifier') != 'app.llmbrain.hub':
            raise ValueError('Unexpected application identifier')
        return metadata['CFBundleShortVersionString']

    before = installed_version()
    if action == 'status':
        return {'version': before, 'path': str(bundle)}
    helper = bundle / 'Contents/MacOS/brain-update'
    result = subprocess.run([str(helper), before, str(bundle) if action == 'install' else ''],
                            capture_output=True, text=True, timeout=270)
    if result.returncode:
        raise ValueError(result.stderr.strip()[:500] or 'Desktop update failed')
    after = installed_version()
    return {'previous_version': before, 'version': after, 'restart_required': before != after,
            'message': result.stdout.strip()}

def call(name,a):
    if name in ('diagnostics_list','diagnostics_read'):
        if a.get('hub'): raise ValueError('Diagnostics are local to this computer')
        if name == 'diagnostics_read': return read_diagnostic(a['report'])
        return {'reports':[{'report':key,'bytes':path.stat().st_size,
                            'modified':datetime.datetime.fromtimestamp(path.stat().st_mtime,datetime.timezone.utc).isoformat()}
                           for key,path in diagnostic_reports().items()]}
    if name == 'desktop_update':
        if a.get('hub'): raise ValueError('desktop_update operates on this client computer')
        return desktop_update(a['action'])
    a=dict(a);named=a.pop('hub','');base=hub_base(named)
    def rq(path,payload=None,form=False,timeout=40):return request(path,payload,form=form,timeout=timeout,base=base)
    tid=lambda:int(a['id'])
    if name=='hub_update':
        if a['action']!='settings' and any(k in a for k in ('auto_enabled','interval_hours')):raise ValueError('Settings require action=settings')
        if a['action']=='status':return rq('/api/hub-update')
        if a['action']=='settings' and not any(k in a for k in ('auto_enabled','interval_hours')):raise ValueError('Give auto_enabled or interval_hours')
        return rq('/api/hub-update',a)
    if name=='queue_list':return rq('/api/intake/queue')
    if name=='queue_issue':return rq('/api/intake/queue',a)
    if name=='queue_control':return rq('/api/intake/action',a)
    if name=='session_list':  # no hub named: this hub and every online peer, each row saying its hub
        n=rq('/api/cluster/nodes');rows=[{**t,'hub':(n.get('self') or {}).get('node','')} for t in rq('/api/terminals')]
        for p in ([] if named else n.get('peers') or []):
            if not p.get('ok'):continue
            try:rows+=[{**t,'hub':(p.get('info') or {}).get('node','')} for t in request('/api/terminals',base=checked(p.get('url','')),timeout=8)]
            except (ValueError,OSError):pass  # a peer that fails is left out
        return rows
    if name=='hubs_list':
        n=rq('/api/cluster/nodes');me=(n.get('self') or {}).get('node','')
        hubs=[{'hub':me,'ok':True,'configured':True}]+[{'hub':(p.get('info') or {}).get('node',''),'ok':bool(p.get('ok'))} for p in n.get('peers') or []]
        machines=sorted({h['hub'] for h in hubs if h['ok'] and h['hub']}|{t.get('host','') for t in rq('/api/terminals') if t.get('status') in ('live','starting')}-{''})
        return {'hubs':hubs,'machines':machines}
    if name=='session_detail':return rq('/api/terminals/%d/detail'%tid())
    if name=='session_rename':return rq('/terminals/%d/rename'%tid(),{'title':a['title']},form=True)
    if name=='session_close':return rq('/api/terminals/%d/close'%tid(),{})
    if name=='session_move':
        body={'to':a['to'],'clone':True} if a.get('mode')=='clone' else {'to':a['to'],'close_source':True}
        if a.get('without_folder') and (a.get('destination_path') or a.get('pin_path')):raise ValueError('without_folder cannot be combined with a path or pin')
        if a.get('pin_path') and not a.get('destination_path'):raise ValueError('pin_path requires destination_path')
        if a.get('destination_path') or a.get('without_folder'):rq('/api/move-folders')  # refuse old hubs that would ignore the new options
        for key in ('destination_path','pin_path','without_folder'):
            if key in a:body[key]=a[key]
        return rq('/api/terminals/%d/migrate'%tid(),body)
    if name=='move_folders':
        if a['action']=='list':return rq('/api/move-folders')
        required=('from_host','source_path','to','destination_path') if a['action']=='set' else ('from_host','source_path','to')
        if any(not a.get(k) for k in required):raise ValueError('Give '+', '.join(required))
        return rq('/api/move-folders',a)
    if name=='move_status':
        if not re.fullmatch(r'[a-f0-9]{64}',a['job']):raise ValueError('Invalid job')
        return rq('/api/migrations/'+a['job'])
    if name=='workspace_get':return rq('/api/workspace')
    if name=='workspace_control':
        if a['action'] in ('open','focus') and 'terminal' not in a:raise ValueError('Give terminal')
        if a['action']=='layout' and 'layout' not in a:raise ValueError('Give layout')
        return rq('/api/workspace/intent',a)
    if name=='session_screen':
        x=rq('/api/terminals/%d/screen'%a['id']);text=x['screen']
        return {'screen':text[-16000:],'truncated':len(text)>16000,'screen_hash':hashlib.sha256(text.encode()).hexdigest()}
    if name=='session_send':
        if not re.fullmatch(r'[a-f0-9]{64}',a['expected_screen_hash']):raise ValueError('A fresh screen hash is required')
        payload={k:v for k,v in a.items() if k!='id'}
        if not payload.get('text') and not payload.get('keys'):raise ValueError('Give text or keys')
        return rq('/api/terminals/%d/send'%a['id'],payload)
    if name=='session_wait':
        q={'until':a.get('until') or ('output' if a.get('text') else 'quiet'),'text':a.get('text',''),'quiet':a.get('quiet_seconds',6),'timeout':a.get('timeout_seconds',180)}
        return rq('/api/terminals/%d/wait?%s'%(a['id'],urllib.parse.urlencode(q)),timeout=q['timeout']+30)
    if name=='session_wait_many':
        if not a['ids']:raise ValueError('Give at least one session id')
        q={'ids':','.join(str(i) for i in a['ids']),'mode':a.get('mode','all'),'until':a.get('until') or ('output' if a.get('text') else 'quiet'),'text':a.get('text',''),'quiet':a.get('quiet_seconds',6),'timeout':a.get('timeout_seconds',180)}
        return rq('/api/terminals/wait?'+urllib.parse.urlencode(q),timeout=q['timeout']+30)
    if name=='session_create':
        f={'format':'json','cli':a.get('provider','auto'),'host':a.get('host',''),'path':a.get('cwd',''),'prompt':a['prompt'],'perm':'full','wt_slug':a.get('worktree_slug',''),'wt_base':a.get('worktree_base','')}
        return rq('/terminals/new',f,form=True)
    if name=='memory_search':return rq('/api/memory/context?'+urllib.parse.urlencode(a))
    raise ValueError('Unknown tool')

def respond(msg):
    method=msg.get('method')
    if method=='initialize':
        return {'protocolVersion':'2025-06-18','capabilities':{'tools':{}},'serverInfo':{'name':'brain','version':'1.2.0'},'instructions':INSTRUCTIONS}
    if method=='ping':return {}
    if method=='tools/list':return {'tools':TOOLS}
    if method=='tools/call':
        p=msg.get('params',{})
        if not isinstance(p,dict):raise ValueError('Invalid tool parameters')
        a=p.get('arguments',{});name=p.get('name')
        spec=next((t for t in TOOLS if t['name']==name),None)
        if spec is None:raise ValueError('Unknown tool')
        try:
            validate(a,spec['inputSchema']);result=call(name,a)
            text=json.dumps(result)
            if len(text)>32768:text=json.dumps({'truncated':True,'excerpt':text[:30000],'hint':'Use a focused session or memory query for details.'})
            return {'content':[{'type':'text','text':text}]}
        except (ValueError,KeyError,TypeError,OSError,subprocess.TimeoutExpired):
            return {'isError':True,'content':[{'type':'text','text':'Hub operation failed. Inspect the queue/session and verify arguments, assignment, fresh allowance and expected screen hash. No automatic retry was made.'}]}
    raise ValueError('Unknown method')

if __name__=='__main__':
    while True:
        line=sys.stdin.buffer.readline(128*1024+1)
        if not line:break
        if len(line)>128*1024:sys.exit('MCP message too large')
        try:
            msg=json.loads(line)
            if not isinstance(msg,dict):raise ValueError()
        except ValueError:
            print(json.dumps({'jsonrpc':'2.0','id':None,'error':{'code':-32700,'message':'Invalid JSON request'}}),flush=True);continue
        if 'id' not in msg:continue
        try:out={'jsonrpc':'2.0','id':msg['id'],'result':respond(msg)}
        except (ValueError,TypeError,KeyError):out={'jsonrpc':'2.0','id':msg['id'],'error':{'code':-32601,'message':'Unknown or invalid MCP method'}}
        print(json.dumps(out),flush=True)
