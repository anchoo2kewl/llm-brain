    tool('session_create','Start a durable managed Claude/Codex Hub session on its selected host. Use only for explicit owner requests; prefer queue_issue for tracked issues. Does not run implementation in the external client.',{'host':STR,'provider':{'type':'string','enum':['auto','claude','codex']},'cwd':STR,'prompt':STR,'worktree_slug':STR,'worktree_base':STR},('prompt',)),
    tool('hubs_list','List the configured hub, its peer hubs (node names to pass as hub) and the machines sessions can run on or move to.',{},read=True),
    tool('session_detail','Read one session: machine, folder, provider, state and its conversation.',{'id':NUM},('id',),read=True),
    tool('session_rename','Rename a session.',{'id':NUM,'title':{'type':'string','maxLength':200}},('id','title'),idem=True),
