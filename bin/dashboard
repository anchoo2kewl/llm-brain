#!/usr/bin/env python3
"""llm-brain dashboard — read-only status page, no login.

Binds ONLY to this machine's Tailscale IPv4 (plus 127.0.0.1), so it is reachable
from the tailnet and nowhere else. Serves:
  /             the page (auto-refreshes)
  /status.json  the snapshot `fleet tick` writes every 5 minutes
  /log/<name>   tail of one worker log (names come from the snapshot only)
Usage: dashboard [port]   (default 8787)
"""
import http.server, json, re, socketserver, subprocess, sys, threading
from pathlib import Path

STATE = Path.home() / ".local/state/llm-brain"
PORT = int(sys.argv[1]) if len(sys.argv) > 1 else 8787
SAFE_LOG = re.compile(r"^[A-Za-z0-9._-]+\.log$")


def tailscale_ip():
    for exe in ("/usr/local/bin/tailscale", "/opt/homebrew/bin/tailscale",
                "/Applications/Tailscale.app/Contents/MacOS/Tailscale"):
        try:
            ip = subprocess.run([exe, "ip", "-4"], capture_output=True, text=True, timeout=5).stdout.split()
            if ip:
                return ip[0]
        except (OSError, subprocess.TimeoutExpired):
            pass
    return None


PAGE = r"""<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1"><title>llm-brain fleet</title>
<style>
:root{--bg:#f7f7f5;--card:#fff;--fg:#1b1b1a;--mut:#6b6b66;--line:#e4e3de;--ok:#1f7a4d;--warn:#a15c00;--bad:#b42318;--acc:#2f5bd3}
@media (prefers-color-scheme:dark){:root{--bg:#141413;--card:#1d1d1b;--fg:#ecebe6;--mut:#9a998f;--line:#2e2d2a;--ok:#4cc38a;--warn:#e0a24a;--bad:#f2766b;--acc:#7da2ff}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font:14px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
main{max-width:1100px;margin:0 auto;padding:20px 16px 60px}
h1{font-size:20px;margin:0}h2{font-size:13px;text-transform:uppercase;letter-spacing:.06em;color:var(--mut);margin:26px 0 8px}
.top{display:flex;flex-wrap:wrap;gap:8px 16px;align-items:baseline;justify-content:space-between}
.meta{color:var(--mut);font-size:13px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-top:14px}
.tile{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:12px}.tile b{display:block;font-size:22px}.tile span{color:var(--mut);font-size:12px}
table{width:100%;border-collapse:collapse;background:var(--card);border:1px solid var(--line);border-radius:10px;overflow:hidden}
td,th{padding:8px 10px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}th{font-size:12px;color:var(--mut);font-weight:600}
tr:last-child td{border-bottom:0}a{color:var(--acc);text-decoration:none}a:hover{text-decoration:underline}
.pill{display:inline-block;padding:1px 8px;border-radius:99px;font-size:12px;border:1px solid var(--line)}
.ok{color:var(--ok)}.warn{color:var(--warn)}.bad{color:var(--bad)}.mut{color:var(--mut)}
.empty{color:var(--mut);padding:10px 2px}pre{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:10px;overflow:auto;max-height:360px;font-size:12px;white-space:pre-wrap}
.wrap{overflow-x:auto}button{font:inherit;background:none;border:0;color:var(--acc);cursor:pointer;padding:0}
</style></head><body><main>
<div class="top"><h1>llm-brain fleet</h1><div class="meta" id="meta">loading…</div></div>
<div class="grid" id="tiles"></div>
<h2>Issues in flight</h2><div class="wrap" id="owned"></div>
<h2>Queue (next up)</h2><div class="wrap" id="queue"></div>
<h2>Fleet PRs</h2><div class="wrap" id="prs"></div>
<h2>PR reviews posted</h2><div class="wrap" id="reviews"></div>
<h2>Running workers</h2><div class="wrap" id="workers"></div>
<div id="logbox"></div>
<h2>Scheduler log</h2><pre id="log"></pre>
</main><script>
const $=id=>document.getElementById(id), esc=s=>String(s??"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const ago=t=>{if(!t)return"";const s=(Date.now()-new Date(t))/1000;return s<90?Math.round(s)+"s ago":s<5400?Math.round(s/60)+"m ago":Math.round(s/3600)+"h ago"};
const table=(rows,head,fn)=>rows.length?`<table><tr>${head.map(h=>`<th>${h}</th>`).join("")}</tr>${rows.map(fn).join("")}</table>`:`<div class="empty">None.</div>`;
const lab=l=>(l||[]).map(x=>x.name).filter(n=>n.startsWith("agent")).map(n=>`<span class="pill ${n.includes("blocked")?"bad":n.includes("pr-open")?"ok":"warn"}">${esc(n)}</span>`).join(" ");
const who=a=>({"Assurio-n7n":"Naj","greg-aligiannis":"Greg"}[a?.login]||a?.login||"");
async function showLog(name){const r=await fetch("/log/"+encodeURIComponent(name));$("logbox").innerHTML=`<h2>${esc(name)} <button onclick="$('logbox').innerHTML=''">close</button></h2><pre>${esc(await r.text())}</pre>`;}
async function load(){
 let d; try{d=await (await fetch("/status.json",{cache:"no-store"})).json()}catch(e){$("meta").textContent="no snapshot yet";return}
 const stale=(Date.now()-new Date(d.at))/1000>660;
 $("meta").innerHTML=`${esc(d.host)} · snapshot ${ago(d.at)} ${stale?'<span class="bad">(stale — scheduler not running?)</span>':""} ${d.paused?'· <span class="bad">PAUSED</span>':""}`;
 const red=d.reviews.filter(r=>r.verdict==="COMMENT").length;
 $("tiles").innerHTML=[[`${d.owned.length}/${d.max_in_flight}`,"issues in flight"],[d.queue.filter(q=>!q.by_hand).length,"queued"],[d.prs.length,"open fleet PRs"],
  [d.reviews.filter(r=>r.verdict==="APPROVE").length,"reviews approved"],[red,"reviews with blockers"],[d.workers.length,"workers running"],
  [d.roles.implementer+" / "+d.roles.internal_reviewer,"implement / check"]].map(([b,s])=>`<div class="tile"><b>${esc(b)}</b><span>${s}</span></div>`).join("");
 $("owned").innerHTML=table(d.owned,["Issue","From","State","Updated"],i=>`<tr><td><a href="${i.url}">#${i.number}</a> ${esc(i.title)}</td><td>${who(i.author)}</td><td>${lab(i.labels)}</td><td class="mut">${ago(i.updatedAt)}</td></tr>`);
 $("queue").innerHTML=table(d.queue,["Issue","From","Filed","Note"],i=>`<tr><td><a href="${i.url}">#${i.number}</a> ${esc(i.title)}</td><td>${who(i.author)}</td><td class="mut">${ago(i.createdAt)}</td><td class="mut">${i.by_hand?"being worked by hand (open PR)":"waits for a free slot"}</td></tr>`);
 $("prs").innerHTML=table(d.prs,["PR","CI","Review","Merge","Updated"],p=>`<tr><td><a href="${p.url}">${esc(p.title)}</a></td><td class="${p.ci==="passing"?"ok":p.ci==="failing"?"bad":"warn"}">${p.ci}</td><td>${esc(p.reviewDecision||"—")}</td><td class="mut">${esc(p.mergeStateStatus)}</td><td class="mut">${ago(p.updatedAt)}</td></tr>`);
 $("reviews").innerHTML=table(d.reviews,["PR","Verdict","Detail","When",""],r=>`<tr><td>${r.url?`<a href="${r.url}">${esc(r.url.replace("https://github.com/elastio/",""))}</a>`:"—"}</td><td class="${r.verdict==="APPROVE"?"ok":r.verdict==="COMMENT"?"warn":"bad"}">${esc(r.verdict)}</td><td class="mut">${esc(r.detail)}</td><td class="mut">${ago(r.at)}</td><td><button onclick="showLog('${esc(r.log)}')">log</button></td></tr>`);
 $("workers").innerHTML=table(d.workers,["Worker","Started",""],w=>`<tr><td>${esc(w.key)}</td><td class="mut">${ago(w.since)}</td><td>${w.log?`<button onclick="showLog('${esc(w.log)}')">log</button>`:""}</td></tr>`);
 $("log").textContent=d.log||"";
}
load();setInterval(load,15000);
</script></body></html>"""


class Handler(http.server.BaseHTTPRequestHandler):
    def _send(self, code, body, ctype):
        data = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path in ("/", "/index.html"):
            return self._send(200, PAGE, "text/html; charset=utf-8")
        if self.path.startswith("/status.json"):
            f = STATE / "status.json"
            return self._send(200, f.read_bytes() if f.exists() else b"{}", "application/json")
        if self.path.startswith("/log/"):
            name = self.path[5:].split("?")[0]
            from urllib.parse import unquote
            name = unquote(name)
            if not SAFE_LOG.match(name):
                return self._send(400, "bad name", "text/plain")
            f = STATE / "logs" / name
            if not f.exists():
                return self._send(404, "not found", "text/plain")
            lines = f.read_text(errors="replace").splitlines()[-400:]
            return self._send(200, "\n".join(lines), "text/plain; charset=utf-8")
        return self._send(404, "not found", "text/plain")

    def log_message(self, *a):
        pass


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True


def main():
    addrs = ["127.0.0.1"]
    ts = tailscale_ip()
    if ts:
        addrs.append(ts)
    else:
        print("warning: no Tailscale IP; serving on localhost only", file=sys.stderr)
    servers = [Server((a, PORT), Handler) for a in addrs]
    for s in servers[1:]:
        threading.Thread(target=s.serve_forever, daemon=True).start()
    print("serving on " + ", ".join(f"http://{a}:{PORT}" for a in addrs), file=sys.stderr, flush=True)
    servers[0].serve_forever()


if __name__ == "__main__":
    main()
