diff --git a/hub/internal/store/recover.go b/hub/internal/store/recover.go
new file mode 100644
index 0000000..7ffdb4b
--- /dev/null
+++ b/hub/internal/store/recover.go
@@ -0,0 +1,33 @@
+package store
+
+import (
+	"context"
+	"fmt"
+)
+
+// AdoptLocalTerminal imports only missing records; an id owned by another host
+// is an error, never an overwrite or a command to start/kill a process.
+func (s *Store) AdoptLocalTerminal(ctx context.Context, t Terminal) error {
+	if t.ID <= 0 || t.Host == "" || t.Cwd == "" {
+		return fmt.Errorf("invalid recovered terminal")
+	}
+	now := Now()
+	_, err := s.DB.ExecContext(ctx, `INSERT INTO terminals
+		(id,host,provider,cwd,model,title,status,created_at,updated_at,live_at,session_uuid,profile)
+		VALUES (?,?,?,?,?,?,'live',?,?,?,?,?) ON CONFLICT(id) DO NOTHING`,
+		t.ID, t.Host, t.Provider, t.Cwd, t.Model, t.Title, now, now, now, t.SessionUUID, t.Profile)
+	if err != nil {
+		return err
+	}
+	x, err := s.Terminal(ctx, t.ID)
+	if err != nil {
+		return err
+	}
+	if x.Host != t.Host {
+		return fmt.Errorf("id belongs to host %s; left untouched", x.Host)
+	}
+	if x.SessionUUID != "" && t.SessionUUID != "" && x.SessionUUID != t.SessionUUID {
+		return fmt.Errorf("conversation identity differs; left untouched")
+	}
+	return nil
+}
