diff --git a/hub/internal/agent/recover.go b/hub/internal/agent/recover.go
new file mode 100644
index 0000000..dfb67b9
--- /dev/null
+++ b/hub/internal/agent/recover.go
@@ -0,0 +1,72 @@
+package agent
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"regexp"
+	"strconv"
+	"strings"
+
+	"github.com/anchoo2kewl/llm-brain/hub/internal/store"
+)
+
+var recoveredUUID = regexp.MustCompile(`(?:--session-id|--resume)\s+([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})`)
+
+// RecoverLocalTerminals registers surviving tmux processes without restarting them.
+// It only runs for the executor backed by this hub's own queue, never a remote inventory.
+func (e *Executor) RecoverLocalTerminals(ctx context.Context, s *store.Store) error {
+	t, err := e.tmux()
+	if err != nil {
+		return err
+	}
+	out, err := t.run(ctx, "list-panes", "-a", "-F", "#{session_name}\t#{session_path}\t#{pane_current_command}\t#{pane_start_command}\t#{@brain-terminal}")
+	if err != nil {
+		if live, ok := e.Terminals(ctx); ok && len(live) == 0 {
+			return nil
+		}
+		return err
+	}
+	seen := map[int64]bool{}
+	for _, line := range strings.Split(out, "\n") {
+		x, ok := recoveredTerminal(line, e.Host)
+		if !ok || seen[x.ID] {
+			continue
+		}
+		seen[x.ID] = true
+		if err := s.AdoptLocalTerminal(ctx, x); err != nil {
+			return fmt.Errorf("recover terminal %d: %w", x.ID, err)
+		}
+	}
+	return nil
+}
+
+func recoveredTerminal(line, host string) (store.Terminal, bool) {
+	f := strings.SplitN(line, "\t", 5)
+	if len(f) != 5 || !strings.HasPrefix(f[0], "llmb-") {
+		return store.Terminal{}, false
+	}
+	id, err := strconv.ParseInt(strings.TrimPrefix(f[0], "llmb-"), 10, 64)
+	if err != nil || id <= 0 || !strings.HasPrefix(f[1], "/") {
+		return store.Terminal{}, false
+	}
+	x := store.Terminal{ID: id, Host: host, Provider: "shell", Cwd: f[1], Title: "Recovered session"}
+	var meta TermOpen
+	if json.Unmarshal([]byte(f[4]), &meta) == nil && KnownProvider(meta.Provider) {
+		x.Provider, x.Model, x.Profile = meta.Provider, meta.Model, meta.Profile
+		x.SessionUUID = meta.SessionID
+	} else {
+		for _, p := range []string{"claude", "codex", "gemini"} {
+			if f[2] == p || strings.Contains(f[3], p+" ") {
+				x.Provider = p
+				break
+			}
+		}
+	}
+	if x.SessionUUID == "" {
+		if m := recoveredUUID.FindStringSubmatch(f[3]); len(m) == 2 {
+			x.SessionUUID = m[1]
+		}
+	}
+	return x, true
+}
