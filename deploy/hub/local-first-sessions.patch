@@ -0,0 +1,52 @@
+package store
+
+import (
+	"context"
+	"path/filepath"
+	"testing"
+)
+
+func TestAdoptLocalTerminal(t *testing.T) {
+	s, err := Open(filepath.Join(t.TempDir(), "hub.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	ctx := context.Background()
+	x := Terminal{ID: 111, Host: "laptop", Provider: "claude", Cwd: "/tmp/code", SessionUUID: "original-conversation"}
+	if err := s.AdoptLocalTerminal(ctx, x); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.RenameTerminal(ctx, 111, "My work"); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.AdoptLocalTerminal(ctx, x); err != nil {
+		t.Fatal(err)
+	}
+	got, err := s.Terminal(ctx, 111)
+	if err != nil || got.Title != "My work" || got.Status != "live" || got.SessionUUID != x.SessionUUID {
+		t.Fatalf("%+v %v", got, err)
+	}
+	x.Host = "studio"
+	if err := s.AdoptLocalTerminal(ctx, x); err == nil {
+		t.Fatal("stole another host's terminal")
+	}
+	x.Host = "laptop"
+	x.SessionUUID = "different"
+	if err := s.AdoptLocalTerminal(ctx, x); err == nil {
+		t.Fatal("accepted different conversation")
+	}
+	got, _ = s.Terminal(ctx, 111)
+	if got.Host != "laptop" || got.SessionUUID != "original-conversation" {
+		t.Fatal("changed original")
+	}
+	id, err := s.CreateTerminal(ctx, Terminal{Host: "laptop", Provider: "shell", Cwd: "/tmp"}, Command{Host: "laptop", Kind: "term_open"})
+	if err != nil || id <= 111 {
+		t.Fatalf("reused recovered id: %d %v", id, err)
+	}
+	var n int
+	s.DB.QueryRowContext(ctx, "SELECT count(*) FROM commands WHERE agent_id=111").Scan(&n)
+	if n != 0 {
+		t.Fatal("recovery queued a process command")
+	}
+}
