+package web
+
+import (
+	"context"
+	"github.com/anchoo2kewl/llm-brain/hub/internal/store"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestRecoveredNoticeOnlyUsesLocalCredential(t *testing.T) {
+	r := newSessRig(t)
+	dir := filepath.Join(r.srv.StateDir, "terminal-context", "111")
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "notice.token"), []byte("private-test-credential"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	for _, x := range []store.Terminal{{ID: 111, Host: r.srv.Host, Provider: "claude", Cwd: "/tmp"}, {ID: 112, Host: "another-machine", Provider: "claude", Cwd: "/tmp"}} {
+		if err := r.st.AdoptLocalTerminal(context.Background(), x); err != nil {
+			t.Fatal(err)
+		}
+	}
+	remote := filepath.Join(r.srv.StateDir, "terminal-context", "112")
+	os.MkdirAll(remote, 0700)
+	os.WriteFile(filepath.Join(remote, "notice.token"), []byte("private-test-credential"), 0600)
+	for _, test := range []struct {
+		id, token string
+		want      int
+	}{{"111", "", 403}, {"111", "wrong", 403}, {"111", "private-test-credential", 204}, {"112", "private-test-credential", 403}} {
+		req, _ := http.NewRequest("POST", r.ts.URL+"/api/terminals/"+test.id+"/question", strings.NewReader(`{"message":"Recovered notification"}`))
+		req.Header.Set("Content-Type", "application/json")
+		req.Header.Set("X-Hub-Notice-Token", test.token)
+		res, err := r.cl.Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		res.Body.Close()
+		if res.StatusCode != test.want {
+			t.Fatalf("%s: %d want %d", test.id, res.StatusCode, test.want)
+		}
+	}
+}
