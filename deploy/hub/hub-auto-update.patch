@@ -0,0 +1,28 @@
+package web
+
+import (
+	"path/filepath"
+	"testing"
+)
+
+func TestWorkspaceSurvivesHubRestart(t *testing.T) {
+	file := filepath.Join(t.TempDir(), "workspace.json")
+	var before workspaceCtl
+	before.restore(file)
+	first := before.push(wsIntent{Action: "open", Terminal: 7, Client: "mac:1"})
+	before.report(wsClient{Client: "mac:1", Slots: []int64{7}, Focus: 7})
+	var after workspaceCtl
+	after.restore(file)
+	seq, intents, clients := after.since(0)
+	if seq != first.Seq || len(intents) != 1 || len(clients) != 1 || clients[0].Focus != 7 {
+		t.Fatalf("lost workspace: %d %+v %+v", seq, intents, clients)
+	}
+	next := after.push(wsIntent{Action: "unzoom", Client: "mac:1"})
+	if next.Seq != first.Seq+1 {
+		t.Fatal("sequence reset")
+	}
+	after.restore(file)
+	if n, _, _ := after.since(0); n != next.Seq {
+		t.Fatal("second listener reset workspace")
+	}
+}
