+
+// Keep sequence numbers and window reports across hub restarts; existing desktop clients may not
+// re-report an unchanged pane tree and must not lose the first command after a sequence reset.
+type workspaceSaved struct {
+	Seq     int64
+	Intents []wsIntent
+	Clients map[string]wsClient
+}
+
+func (c *workspaceCtl) restore(file string) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.stateFile != "" {
+		return
+	}
+	c.stateFile = file
+	f, err := os.Open(file)
+	if os.IsNotExist(err) {
+		return
+	}
+	if err != nil {
+		log.Printf("workspace restore: %v", err)
+		return
+	}
+	defer f.Close()
+	var state workspaceSaved
+	if err := json.NewDecoder(io.LimitReader(f, 1<<20)).Decode(&state); err != nil {
+		log.Printf("workspace restore: %v", err)
+		return
+	}
+	if state.Seq < 0 || len(state.Intents) > wsKeep || len(state.Clients) > wsMaxClients {
+		log.Printf("workspace restore: invalid snapshot")
+		return
+	}
+	c.seq, c.intents, c.clients = state.Seq, state.Intents, state.Clients
+}
+func (c *workspaceCtl) saveLocked() {
+	if c.stateFile == "" {
+		return
+	}
+	data, err := json.Marshal(workspaceSaved{c.seq, c.intents, c.clients})
+	if err != nil {
+		return
+	}
+	if err = os.MkdirAll(filepath.Dir(c.stateFile), 0700); err != nil {
+		log.Printf("workspace save: %v", err)
+		return
+	}
+	f, err := os.CreateTemp(filepath.Dir(c.stateFile), "workspace-*")
+	if err != nil {
+		log.Printf("workspace save: %v", err)
+		return
+	}
+	name := f.Name()
+	defer os.Remove(name)
+	if _, err = f.Write(data); err == nil {
+		err = f.Close()
+	} else {
+		f.Close()
+	}
+	if err == nil {
+		err = os.Rename(name, c.stateFile)
+	}
+	if err != nil {
+		log.Printf("workspace save: %v", err)
+	}
+}
