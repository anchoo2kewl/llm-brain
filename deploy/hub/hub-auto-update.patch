+package web
+
+func (s *Server) hubMigrationBusy() bool {
+	if s.Agents == nil {
+		return false
+	}
+	ms := &s.Agents.migs
+	ms.mu.Lock()
+	defer ms.mu.Unlock()
+	for _, j := range ms.m {
+		if !j.Done {
+			return true
+		}
+	}
+	return false
+}
