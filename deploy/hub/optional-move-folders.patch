+
+// A selected or pinned path must exist. Automatic legacy moves may fall back to home.
+func sessionDestination(raw string, strict bool, home string, roots Roots) (string, error) {
+	cwd := strings.TrimSpace(raw)
+	if cwd == "" || cwd == "~" {
+		cwd = home
+	} else if strings.HasPrefix(cwd, "~/") {
+		cwd = home + "/" + cwd[2:]
+	}
+	if real, err := roots.Validate(cwd); err == nil {
+		return real, nil
+	}
+	// Managed session migration already permits folders below the user's home.
+	if filepath.Clean(cwd) == filepath.Clean(home) {
+		return home, nil
+	}
+	if real, err := NewRoots([]string{home}).Validate(cwd); err == nil {
+		return real, nil
+	}
+	if strict {
+		return "", fmt.Errorf("selected destination folder %q does not exist or is outside allowed roots", raw)
+	}
+	return home, nil
+}
