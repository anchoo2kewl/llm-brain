diff --git a/hub/internal/web/move_folders.go b/hub/internal/web/move_folders.go
new file mode 100644
index 0000000..5fe5341
--- /dev/null
+++ b/hub/internal/web/move_folders.go
@@ -0,0 +1,132 @@
+package web
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"path"
+	"strings"
+
+	"github.com/anchoo2kewl/llm-brain/hub/internal/agent"
+)
+
+// MoveFolder pins a source working folder to its existing checkout on another machine.
+type MoveFolder struct {
+	From            string `json:"from_host"`
+	SourcePath      string `json:"source_path"`
+	To              string `json:"to"`
+	DestinationPath string `json:"destination_path"`
+}
+
+func validMovePath(p string) bool {
+	if len(p) > 4096 || strings.ContainsAny(p, "\x00\r\n") || !(strings.HasPrefix(p, "/") || p == "~" || strings.HasPrefix(p, "~/")) {
+		return false
+	}
+	for _, part := range strings.Split(p, "/") {
+		if part == ".." {
+			return false
+		}
+	}
+	return true
+}
+
+func validateMoveFolder(r MoveRequest) error {
+	if r.WithoutFolder && (r.DestinationPath != "" || r.PinPath) {
+		return agent.InputError{Msg: "without_folder cannot be combined with destination_path or pin_path"}
+	}
+	if r.DestinationPath != "" && !validMovePath(r.DestinationPath) {
+		return agent.InputError{Msg: "destination_path must be absolute or ~/..., without '..'"}
+	}
+	if r.PinPath && r.DestinationPath == "" {
+		return agent.InputError{Msg: "pin_path requires destination_path"}
+	}
+	return nil
+}
+
+func (s *Server) moveFolder(ctx context.Context, from, cwd string, r MoveRequest) (string, bool, error) {
+	if err := validateMoveFolder(r); err != nil {
+		return "", false, err
+	}
+	if r.WithoutFolder {
+		return "~", true, nil
+	}
+	if r.DestinationPath != "" {
+		return r.DestinationPath, true, nil
+	}
+	var dest string
+	err := s.Store.DB.QueryRowContext(ctx, `SELECT destination_path FROM move_folders WHERE from_host=? AND source_path=? AND to_host=?`, from, cleanMovePath(cwd), r.To).Scan(&dest)
+	if errors.Is(err, sql.ErrNoRows) {
+		return portableHome(cwd), false, nil
+	}
+	if err != nil {
+		return "", false, err
+	}
+	return dest, true, nil
+}
+
+func cleanMovePath(p string) string { return path.Clean(portableHome(p)) }
+
+func (s *Server) saveMoveFolder(ctx context.Context, p MoveFolder) error {
+	if p.From == "" || len(p.From) > 128 || p.To == "" || len(p.To) > 128 || !validMovePath(p.SourcePath) || !validMovePath(p.DestinationPath) {
+		return agent.InputError{Msg: "give from_host, source_path, to and an absolute or ~/... destination_path"}
+	}
+	_, err := s.Store.DB.ExecContext(ctx, `INSERT INTO move_folders(from_host,source_path,to_host,destination_path) VALUES(?,?,?,?) ON CONFLICT(from_host,source_path,to_host) DO UPDATE SET destination_path=excluded.destination_path`, p.From, cleanMovePath(p.SourcePath), p.To, p.DestinationPath)
+	return err
+}
+
+func (s *Server) moveFolderRoutes(g, p func(string, http.HandlerFunc)) {
+	g("GET /api/move-folders", func(w http.ResponseWriter, r *http.Request) {
+		rows, err := s.Store.DB.QueryContext(r.Context(), `SELECT from_host,source_path,to_host,destination_path FROM move_folders ORDER BY from_host,source_path,to_host`)
+		if err != nil {
+			jsonErr(w, 500, err)
+			return
+		}
+		defer rows.Close()
+		pins := []MoveFolder{}
+		for rows.Next() {
+			var pin MoveFolder
+			if err := rows.Scan(&pin.From, &pin.SourcePath, &pin.To, &pin.DestinationPath); err != nil {
+				jsonErr(w, 500, err)
+				return
+			}
+			pins = append(pins, pin)
+		}
+		if err := rows.Err(); err != nil {
+			jsonErr(w, 500, err)
+			return
+		}
+		writeJSON(w, 200, map[string]any{"mappings": pins})
+	})
+	p("POST /api/move-folders", func(w http.ResponseWriter, r *http.Request) {
+		var req struct {
+			MoveFolder
+			Action string `json:"action"`
+		}
+		if err := json.NewDecoder(io.LimitReader(r.Body, 16384)).Decode(&req); err != nil {
+			jsonErr(w, 400, err)
+			return
+		}
+		var err error
+		switch req.Action {
+		case "", "set":
+			err = s.saveMoveFolder(r.Context(), req.MoveFolder)
+		case "remove":
+			if req.From == "" || req.To == "" || !validMovePath(req.SourcePath) {
+				jsonErr(w, 400, errors.New("give from_host, source_path and to"))
+				return
+			}
+			_, err = s.Store.DB.ExecContext(r.Context(), `DELETE FROM move_folders WHERE from_host=? AND source_path=? AND to_host=?`, req.From, cleanMovePath(req.SourcePath), req.To)
+		default:
+			jsonErr(w, 400, errors.New("action must be set or remove"))
+			return
+		}
+		if err != nil {
+			jsonErr(w, 400, err)
+			return
+		}
+		writeJSON(w, 200, map[string]bool{"ok": true})
+	})
+}
