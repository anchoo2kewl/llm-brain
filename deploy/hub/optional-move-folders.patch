diff --git a/hub/internal/agent/extended_keys_test.go b/hub/internal/agent/extended_keys_test.go
new file mode 100644
index 0000000..c67208a
--- /dev/null
+++ b/hub/internal/agent/extended_keys_test.go
@@ -0,0 +1,90 @@
+package agent
+
+import (
+	"bytes"
+	"context"
+	"github.com/creack/pty"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"testing"
+	"time"
+)
+
+// Exercise the actual outer-terminal -> tmux -> application byte path on a separate socket.
+func TestControlEnterBridge(t *testing.T) {
+	bin, err := exec.LookPath("tmux")
+	if err != nil {
+		t.Skip("tmux not installed")
+	}
+	dir := t.TempDir()
+	conf := filepath.Join(dir, "tmux.conf")
+	out := filepath.Join(dir, "key")
+	if err := os.WriteFile(conf, []byte(tmuxConf), 0600); err != nil {
+		t.Fatal(err)
+	}
+	socket := "brain-key-test-" + strconv.Itoa(os.Getpid())
+	run := func(args ...string) *exec.Cmd {
+		return exec.Command(bin, append([]string{"-L", socket, "-f", conf}, args...)...)
+	}
+	command := "stty raw -echo; printf '\\033[>4;2mREADY'; dd bs=1 count=7 of=" + shellQuote(out) + " 2>/dev/null; sleep 1"
+	if b, err := run("new-session", "-d", "-s", "keytest", command).CombinedOutput(); err != nil {
+		t.Fatalf("tmux: %v %s", err, b)
+	}
+	defer run("kill-server").Run()
+	cmd := run("attach-session", "-t", "keytest")
+	cmd.Env = append(os.Environ(), "TERM=xterm-256color")
+	master, err := pty.Start(cmd)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = run("kill-server").Run(); _ = master.Close(); _ = cmd.Wait() }()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	ready := make(chan error, 1)
+	go func() {
+		var data []byte
+		buf := make([]byte, 4096)
+		for len(data) < 65536 {
+			n, err := master.Read(buf)
+			data = append(data, buf[:n]...)
+			if bytes.Contains(data, []byte("READY")) {
+				ready <- nil
+				return
+			}
+			if err != nil {
+				ready <- err
+				return
+			}
+		}
+		ready <- io.ErrNoProgress
+	}()
+	select {
+	case err := <-ready:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-ctx.Done():
+		t.Fatal("terminal did not become ready")
+	}
+	want := []byte("\x1b[13;5u")
+	if _, err := master.Write(want); err != nil {
+		t.Fatal(err)
+	}
+	for {
+		got, _ := os.ReadFile(out)
+		if len(got) >= len(want) {
+			if !bytes.Equal(got, want) {
+				t.Fatalf("Control+Enter became %q", got)
+			}
+			return
+		}
+		select {
+		case <-ctx.Done():
+			t.Fatalf("Control+Enter collapsed or disappeared: %q", got)
+		case <-time.After(10 * time.Millisecond):
+		}
+	}
+}
diff --git a/hub/internal/agent/session_destination_test.go b/hub/internal/agent/session_destination_test.go
new file mode 100644
index 0000000..8dcd758
--- /dev/null
+++ b/hub/internal/agent/session_destination_test.go
@@ -0,0 +1,40 @@
+package agent
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestSessionDestinationSelectedFolder(t *testing.T) {
+	home := t.TempDir()
+	repo := filepath.Join(home, "different", "checkout")
+	if err := os.MkdirAll(repo, 0700); err != nil {
+		t.Fatal(err)
+	}
+	real, _ := filepath.EvalSymlinks(repo)
+	got, err := sessionDestination("~/different/checkout", true, home, Roots{})
+	if err != nil || got != real {
+		t.Fatalf("folder: %s %v", got, err)
+	}
+	if _, err := sessionDestination("~/missing", true, home, Roots{}); err == nil {
+		t.Fatal("selected missing folder silently fell back")
+	}
+	if got, err := sessionDestination("~/missing", false, home, Roots{}); err != nil || got != home {
+		t.Fatalf("legacy fallback: %s %v", got, err)
+	}
+	outside := t.TempDir()
+	link := filepath.Join(home, "outside")
+	if err := os.Symlink(outside, link); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := sessionDestination(link, true, home, Roots{}); err == nil {
+		t.Fatal("accepted symlink outside roots")
+	}
+	parent := t.TempDir()
+	child := filepath.Join(parent, "checkout")
+	_ = os.Mkdir(child, 0700)
+	if _, err := sessionDestination(child, true, home, NewRoots([]string{parent})); err != nil {
+		t.Fatalf("configured root: %v", err)
+	}
+}
