+package web
+
+import (
+	"context"
+	"strings"
+	"testing"
+)
+
+func TestMoveFolderPinsAndOverrides(t *testing.T) {
+	r := newSessRig(t)
+	ctx := context.Background()
+	pin := MoveFolder{From: "laptop", SourcePath: "/Users/alice/code/app", To: "studio", DestinationPath: "~/projects/other/app"}
+	if err := r.srv.saveMoveFolder(ctx, pin); err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		req    MoveRequest
+		want   string
+		strict bool
+	}{
+		{MoveRequest{To: "studio"}, pin.DestinationPath, true},
+		{MoveRequest{To: "studio", DestinationPath: "~/one-time"}, "~/one-time", true},
+		{MoveRequest{To: "studio", WithoutFolder: true}, "~", true},
+		{MoveRequest{To: "other"}, "~/code/app", false},
+	} {
+		got, strict, err := r.srv.moveFolder(ctx, "laptop", "/Users/alice/code/app", tc.req)
+		if err != nil || got != tc.want || strict != tc.strict {
+			t.Fatalf("%+v: %q %v %v", tc.req, got, strict, err)
+		}
+	}
+	for _, req := range []MoveRequest{{DestinationPath: "relative"}, {DestinationPath: "~/../outside"}, {PinPath: true}, {WithoutFolder: true, DestinationPath: "~/app"}} {
+		if validateMoveFolder(req) == nil {
+			t.Fatalf("accepted %+v", req)
+		}
+	}
+	code, body, _ := r.get(t, "/api/move-folders")
+	if code != 200 || !strings.Contains(body, "~/projects/other/app") {
+		t.Fatalf("list: %d %s", code, body)
+	}
+	resp, err := r.cl.Post(r.ts.URL+"/api/move-folders", "application/json", strings.NewReader(`{"action":"remove","from_host":"laptop","source_path":"~/code/app","to":"studio"}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != 200 {
+		t.Fatalf("remove: %d", resp.StatusCode)
+	}
+	_, body, _ = r.get(t, "/api/move-folders")
+	if strings.Contains(body, "~/projects/other/app") {
+		t.Fatal(body)
+	}
+}
