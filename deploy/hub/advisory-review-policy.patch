new file mode 100644
index 0000000..a97bc77
--- /dev/null
+++ b/hub/agent_policy.go
@@ -0,0 +1,81 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"embed"
+	"fmt"
+	"io/fs"
+	"log"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+// Ship the enforcement code with the service. Older updaters only replace hub
+// and MCP assets; policy must not depend on a separate source checkout update.
+//
+//go:embed policyassets/bin/* policyassets/bin/agent-tools/* policyassets/prompts/*
+var agentPolicy embed.FS
+
+func installAgentPolicy(brain string) error {
+	if brain == "" {
+		return fmt.Errorf("agent policy requires a brain directory")
+	}
+	return fs.WalkDir(agentPolicy, "policyassets", func(path string, d fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if d.IsDir() {
+			return nil
+		}
+		data, err := agentPolicy.ReadFile(path)
+		if err != nil {
+			return err
+		}
+		target := filepath.Join(brain, strings.TrimPrefix(path, "policyassets/"))
+		old, _ := os.ReadFile(target)
+		if bytes.Equal(old, data) {
+			return nil
+		}
+		if err := os.MkdirAll(filepath.Dir(target), 0755); err != nil {
+			return err
+		}
+		f, err := os.CreateTemp(filepath.Dir(target), ".agent-policy-*")
+		if err != nil {
+			return err
+		}
+		defer os.Remove(f.Name())
+		if _, err = f.Write(data); err != nil {
+			f.Close()
+			return err
+		}
+		if err = f.Chmod(0755); err != nil {
+			f.Close()
+			return err
+		}
+		if err = f.Close(); err != nil {
+			return err
+		}
+		return os.Rename(f.Name(), target)
+	})
+}
+
+func runAgentAttribution(ctx context.Context, brain string, lg *log.Logger) {
+	for {
+		probe, cancel := context.WithTimeout(ctx, 3*time.Minute)
+		cmd := exec.CommandContext(probe, "python3", filepath.Join(brain, "bin/brain-pr-policy"), "--reconcile")
+		cmd.Env = append(os.Environ(), "PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin")
+		if _, err := cmd.Output(); err != nil && ctx.Err() == nil {
+			lg.Printf("agent attribution audit incomplete: %v", err)
+		}
+		cancel()
+		select {
+		case <-ctx.Done():
+			return
+		case <-time.After(15 * time.Minute):
+		}
+	}
+}
