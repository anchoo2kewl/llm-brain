+package main
+
+import (
+	"bytes"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestEmbeddedAgentPolicyMatchesSource(t *testing.T) {
+	err := fs.WalkDir(agentPolicy, "policyassets", func(path string, d fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if d.IsDir() {
+			return nil
+		}
+		got, err := agentPolicy.ReadFile(path)
+		if err != nil {
+			return err
+		}
+		want, err := os.ReadFile(filepath.Join("..", path[len("policyassets/"):]))
+		if err != nil {
+			return err
+		}
+		if !bytes.Equal(got, want) {
+			t.Errorf("stale embedded policy: %s", path)
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestAgentPolicyInstallsWithHub(t *testing.T) {
+	brain := t.TempDir()
+	if err := installAgentPolicy(brain); err != nil {
+		t.Fatal(err)
+	}
+	p := filepath.Join(brain, "bin/cheap-review")
+	data, err := os.ReadFile(p)
+	if err != nil || !bytes.Contains(data, []byte("event='COMMENT'")) {
+		t.Fatal("missing advisory policy", err)
+	}
+	p = filepath.Join(brain, "bin/agent-tools/gh")
+	st, err := os.Stat(p)
+	if err != nil || st.Mode()&0111 == 0 {
+		t.Fatal("missing executable guard", err)
+	}
+	if err := installAgentPolicy(brain); err != nil {
+		t.Fatal(err)
+	}
+}
