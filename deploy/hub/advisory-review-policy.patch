+#!/usr/bin/env python3
+"""Persistent bounded direct-API review queue, run in the scheduler foreground."""
+import argparse, hashlib, urllib.request, urllib.parse, datetime, contextlib, fcntl, importlib.util, importlib.machinery, json, os, pathlib, subprocess, sys, time
+from api_review_engine import private_write, Stopped
+from review_contract_context import CONTEXT_REVISION
+ROOT=pathlib.Path(os.environ.get('BRAIN_STATE',str(pathlib.Path.home()/'.local/state/llm-brain')))
+BRAIN=pathlib.Path(__file__).resolve().parent.parent
+EXCLUDED_REASONS={'invalid_pr_url','review_repository_outside_scope','review_repository_not_approved',
+ 'private_destination_required','review_pr_not_ready','review_owner_not_eligible'}
+@contextlib.contextmanager
+def state(root=ROOT):
+ root.mkdir(parents=True,exist_ok=True,mode=0o700);path=root/'api-review-queue.json'
+ with open(root/'api-review-queue.lock','a') as f:
+  os.chmod(f.name,0o600);fcntl.flock(f,fcntl.LOCK_EX)
+  data=json.loads(path.read_text()) if path.exists() else {'jobs':{},'created_at':time.time()}
+  yield data
+  data['updated_at']=time.time();private_write(path,data)
+def enqueue(rows,root=ROOT,priority=0):
+ with state(root) as data:
+  for row in rows:
+   url=row if isinstance(row,str) else row['url']
+   if not url.startswith('https://github.com/') or '/pull/' not in url:raise Stopped('invalid_pr_url')
+   job=data['jobs'].setdefault(url,{'url':url,'status':'queued','created_at':time.time(),'retry_at':0,'attempts':0})
+   if job.get('status') in {'closed','excluded'}:job.update(status='queued',reason='rediscovered',retry_at=0)
+   job['seen_at']=time.time();job['priority']=max(job.get('priority',0),priority)
+def gh(*args):
+ r=subprocess.run(['gh',*args],capture_output=True,text=True,timeout=45)
+ if r.returncode:raise Stopped('github_unavailable',time.time()+300)
+ return json.loads(r.stdout)
+def update(url,values,root=ROOT):
+ with state(root) as data:data['jobs'][url].update(values)
+def monitor(url,head,status,reason,root,retry_at=0):
+ loader=importlib.machinery.SourceFileLoader('api_monitor',str(BRAIN/'bin/review-monitor'))
+ spec=importlib.util.spec_from_loader(loader.name,loader);m=importlib.util.module_from_spec(spec);loader.exec_module(m)
+ with m.ledger(root) as data:
+  now=time.time();item=data['items'].setdefault(url,{'eligible':True})
+  if status=='running':item.pop('candidate',None);item.pop('receipt',None)
+  item.update(head=head,status=status,reason=reason,api_retry_at=retry_at,pid=os.getpid(),started=now,since=max(now,retry_at),head_verified=True,head_verified_at=now)
+  data['summary']=m.summary(data,now)
+def receipt(url,head,review_id,root=ROOT):
+ loader=importlib.machinery.SourceFileLoader('review_monitor',str(BRAIN/'bin/review-monitor'))
+ spec=importlib.util.spec_from_loader(loader.name,loader);m=importlib.util.module_from_spec(spec);loader.exec_module(m)
+ with m.ledger(root) as data:
+  now=time.time();item=data['items'].setdefault(url,{'eligible':True,'since':now})
+  item.update(head=head,head_verified=True,head_verified_at=now,status='completed',reason='verified_api',finished=now,
+   receipt={'head':head,'review_id':review_id['id'],'state':review_id['state'],'url':review_id['url'],'submitted':datetime.datetime.fromisoformat(review_id['submitted'].replace('Z','+00:00')).timestamp()})
+  data.setdefault('receipts',{})[url+'@'+head]=item['receipt'];data['summary']=m.summary(data,now)
+def questions(url,head,unknowns=None):
+ endpoint='http://127.0.0.1:8787/api/reviews/questions'
+ try:
+  if unknowns:
+   request=urllib.request.Request(endpoint,data=json.dumps({'url':url,'head':head,'questions':unknowns[:4]}).encode(),headers={'Content-Type':'application/json'},method='POST')
+  else:request=endpoint+'?'+urllib.parse.urlencode({'url':url,'head':head})
+  with urllib.request.urlopen(request,timeout=25) as response:return json.load(response)
+ except (OSError,ValueError):raise Stopped('clarification_service_unavailable',time.time()+300)
+
+# Pending work is not a failure. Runtime failures remain retryable, including
+# previously terminal blocks; clarification waits still require actual evidence.
+PENDING={'herdr_review_running','native_context_ready','head_changed'}
+def failed(url,reason,root=ROOT,retry_at=0,token=None):
+ now=time.time()
+ with state(root) as data:
+  job=data['jobs'][url];tokens=list(job.get('failure_tokens',[]))
+  if token is not None and token in tokens:return
+  count=job.get('consecutive_failures',0)+1
+  if count==1:job['failure_episode']=datetime.datetime.fromtimestamp(now,datetime.timezone.utc).isoformat()
+  if token is not None:tokens=(tokens+[token])[-64:]
+  job.update(consecutive_failures=count,last_failure=reason,failure_tokens=tokens,
+   status='waiting',reason=reason,pid=None,finished_at=now,
+   retry_at=max(retry_at,now+min(3600,60*2**min(count-1,6))))
+
+def notify_failures(root=ROOT):
+ with state(root) as data:jobs=list(data['jobs'].values())
+ for job in jobs:
+  if job.get('consecutive_failures',0)<3 or job.get('failure_alert_head')==job.get('head') or not job.get('head') or job.get('status') in ['closed','completed','quality_completed']:continue
+  if job.get('failure_alert_retry_at',0)>time.time():continue
+  try:
+   from review_authorization import require
+   require(job['url'])
+   question=questions(job['url'],job['head'],[
+    'Review failed more than twice. Incident began '+str(job.get('failure_episode','legacy'))+'. Last failure: '+job.get('last_failure','worker_interrupted')+
+    '. Hub will keep retrying automatically with backoff. Repair the worker/credential/service if needed, then reply “retry” to resume on the next queue tick, or include corrective context. No approval has been issued by this failure alert.'])
+   values={'failure_alert_head':job['head'],'failure_alert_id':question['id'],'failure_alert_error':None,'failure_alert_retry_at':0}
+   if not job.get('question_id'):values['question_id']=question['id']
+   update(job['url'],values,root)
+  except (Stopped,OSError,ValueError,KeyError):
+   update(job['url'],{'failure_alert_error':'telegram_delivery_failed','failure_alert_retry_at':time.time()+300},root)
+
+def native_context(url,head,root=ROOT):
+ enabled=os.environ.get('BRAIN_HERDR_REVIEWS')=='1'
+ # Explicit installation marker enables native review workers for unattended
+ # Hub jobs; ordinary cheap-review and other machines are unaffected.
+ if not enabled and not (root/'herdr-reviews-enabled').exists():return []
+ loader=importlib.machinery.SourceFileLoader('native_review',str(BRAIN/'bin/herdr-review'))
+ spec=importlib.util.spec_from_loader(loader.name,loader);native=importlib.util.module_from_spec(spec);loader.exec_module(native)
+ source=importlib.machinery.SourceFileLoader('native_packet',str(BRAIN/'bin/cheap-review'))
+ spec=importlib.util.spec_from_loader(source.name,source);cli=importlib.util.module_from_spec(spec);source.exec_module(cli)
+ from types import SimpleNamespace
+ packet,meta=cli.packet_for(SimpleNamespace(packet=False,pr=url,focus='Focused contract verification'))
+ if meta['head']!=head:raise Stopped('head_changed',time.time()+60)
+ with state(root) as data:pending=data['jobs'].get(url,{}).get('source_questions',[])
+ if pending:packet += '\n\nResolve these source lookup questions before returning. Search definitions, validation, serialization, and callers; do not ask the owner for code available in this checkout:\n'+json.dumps(pending)
+ native.ROOT=root
+ result=native.ensure(url,head,packet)
+ for failure in result.get('failures',[]):
+  failed(url,failure['reason'],root,token=failure['token'])
+ if result['pending']:raise Stopped('herdr_review_running',time.time()+60)
+ return result['notes']
+
+def answer_version(rows):
+ answers=[{'id':q['id'],'answer':q['answer'],'at':q['answered_at']} for q in rows if q.get('answer')]
+ return hashlib.sha256(json.dumps(answers,sort_keys=True).encode()).hexdigest() if answers else ''
+
+def tick(*,limit=3,only=None,root=ROOT,budget=.10,post_reviews=True):
+ with open(root/'api-review-worker.lock','a') as lock:
+  try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
+  except BlockingIOError:return
+  with state(root) as data:jobs=sorted(data['jobs'].values(),key=lambda j:(-j.get('priority',0),0 if j.get('question_id') else 1,j.get('last_attempt',0),j.get('created_at',0)))
+  try:
+   me=gh('api','user')['login']
+   if not isinstance(me,str) or not me:raise ValueError('missing login')
+  except (Stopped,ValueError,KeyError,TypeError):
+   for job in jobs:
+    if job.get('status') not in ['completed','quality_completed','blocked','closed']:
+     failed(job['url'],'github_identity_unavailable',root,time.time()+300)
+   if post_reviews:notify_failures(root)
+   return
+  attempts=0
+  if post_reviews:notify_failures(root)
+  for old in jobs:
