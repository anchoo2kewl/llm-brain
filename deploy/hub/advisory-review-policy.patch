+  local command=("$BRAIN_DIR/bin/llm-run" "$provider" "$mode" "${SPAWN_CWD:-$WORK_ROOT}" "$prompt_file" "fleet-$key")
+  if [[ "$key" == review-* ]]; then
+    command=("$BRAIN_DIR/bin/review-monitor" run "$BRAIN_REVIEW_URL" "$BRAIN_REVIEW_SHA" "$BRAIN_REVIEW_OWNER" "$logf" -- "${command[@]}")
+  fi
+  nohup gtimeout --kill-after=5m "$timeout" "${command[@]}" >"$logf" 2>&1 </dev/null &
+  echo $! >"$BRAIN_STATE/runs/$key.pid"
+  log "started $key ($provider/$mode, pid $!, log $logf)"
+}
+
+capacity_left() { # work workers (implement/babysit); reviews have their own pool
+  echo $(( $(cfg '.limits.max_workers') - $(running_workers work) ))
+}
+review_capacity_left() {
