+#!/usr/bin/env bash
+# fleet — the issue → PR → merge loop.
+#
+#   fleet tick              chat-watch + dispatch + babysit + review-prs once (what launchd runs)
+#   fleet dispatch          claim agent-ready issues and start implement workers
+#   fleet babysit           start a babysit worker for every marker PR with new activity
+#   fleet review-prs        review every PR that requests me (once per head commit, until it approves)
+#   fleet review-pr <url>   the same for one PR
+#   fleet review <pr-url>   internal review of a PR by the panel (other CLI, Jev, fresh self-pass); prints findings
+#   fleet entropy <pr-url> [--post]  Entropy Score of a PR; --post also shows it on the PR (comment + commit status).
+#                                    `fleet slop` is the old name and still works.
+#   fleet status            claims, running workers, open fleet PRs
+#   fleet labels            create the fleet labels in the intake repos (once)
+#   fleet pause|resume      this machine only
+#   fleet providers         show implementer / reviewers resolution
+# An ephemeral node (config node.role) refuses tick, dispatch, babysit, review-prs, review-pr and review.
+set -euo pipefail
+source "$(dirname "$0")/lib.sh"
+
+# Long-running work belongs to permanent nodes. Exit 0 so launchd does not restart the job in a loop.
+case "${1:-}" in
+  tick|dispatch|babysit|review-prs|review-pr|review)
+    is_permanent || { log "node.role is ephemeral: '$1' runs only on a permanent node"; exit 0; } ;;
+esac
+
+# Validate identity even for direct review-pr invocations that bypass discovery.
