+    local pf="$BRAIN_STATE/runs/issue-$num.prompt"
+    prompt_env implement
+    NOTES="$(notes_for "$repo#$num")" REPO="$repo" ISSUE="$num" HOST="$HOST_NAME" REVIEW_PANEL="$(describe_reviewers)" IMPLEMENTER="$(implementer)" \
+      BRAIN_DIR="$BRAIN_DIR" MARKER="$(cfg '.pr_marker')$num" \
+      REVIEWERS="$(cfg '.reviewers | join(",")')" \
+      render "$BRAIN_DIR/prompts/implement.md" >"$pf"
+    BRAIN_REPO="$repo" BRAIN_ISSUE="$num" spawn "issue-$num" "$(implementer)" write "$(cfg '.limits.implement_timeout')" "$pf"
+    slots=$((slots - 1))
+  done < <(intake_queue)
+}
+
+fleet_prs() { # JSON array of my open PRs for fleet issues: the body marker, or (for an issue the fleet owns) a mention of it
+  local marker owner repo owned
+  marker="$(cfg '.pr_marker')"
+  repo="$(cfg '.intake.repos[0]')"
+  owned="$(in_flight | jq -R 'select(length > 0)' | jq -sc .)"
+  for owner in $(cfg '.pr_owners[]'); do
+    gh search prs --owner "$owner" --author "@me" --state open \
+      --json url,number,repository,updatedAt,title,body --limit 100
+  done | jq -s --arg m "$marker" --arg repo "$repo" --argjson owned "$owned" '
+    ($repo | split("/")[1]) as $name
+    | add // [] | unique_by(.url) | map(
+        ((.body // "") + "\n" + (.title // "")) as $t
+        | ((.body // "") | capture(($m | gsub("[.]"; "\\.")) + "(?<n>[0-9]+)").n // null) as $mk
+        # A companion PR opened without the marker still counts when it names an issue the fleet owns
+        # ("blue-stack#17446" or the issue URL).
+        | ($mk // ([$owned[] | select(. as $n | $t | test("(^|[^A-Za-z0-9_.-])" + $name + "#" + $n + "([^0-9]|$)")
+              or test("github\\.com/" + $repo + "/issues/" + $n + "([^0-9]|$)"))][0])) as $issue
+        | select($issue != null)
+        | {url, number, repository, updatedAt, issue: $issue, marked: ($mk != null)})'
+}
+
+cmd_babysit() {
+  paused && { log "paused"; return; }
+  local row url key fp_file new_fp issue refs plan notes_hash
+  fleet_prs | jq -c '.[]' | while read -r row; do
+    url="$(jq -r .url <<<"$row")"
+    key="pr-$(jq -r '.repository.name + "-" + (.number|tostring)' <<<"$row")"
+    slop_publish "$url" || true                               # the fleet's own PRs show their score too
+    worker_running "$key" && continue
+    issue="$(jq -r '.issue // empty' <<<"$row")"; refs="$(jq -r '.repository.nameWithOwner + "#" + (.number|tostring)' <<<"$row")"
+    [[ -n "$issue" ]] && refs="$refs $(cfg '.intake.repos[0]')#$issue"
+    if [[ -n "$issue" ]] && gh issue view "$issue" -R "$(cfg '.intake.repos[0]')" --json labels --jq '[.labels[].name]' | grep -q "\"$(cfg '.labels.stop')\""; then
+      continue                                                 # someone said stop (label or chat)
+    fi
+    # Don't race the implementation worker on its own branch.
+    [[ -n "$issue" ]] && worker_running "issue-$issue" && continue
+    fp_file="$BRAIN_STATE/prs/$key.fp"
+    notes_hash=""
+    if [[ -n "$(notes_for $refs)" ]]; then notes_hash="$(notes_for $refs | shasum -a 256 | cut -d ' ' -f1)"; fi
+    plan="$(gh pr view "$url" --json headRefOid,reviews,comments,statusCheckRollup,mergeStateStatus,reviewDecision \
+      | "$BRAIN_DIR/bin/fleet-plan" --previous "$fp_file" --owner "$(cfg '.intake.assignee')" \
+          --notes-hash "$notes_hash" --marked "$(jq -r '.marked // false' <<<"$row")" \
+          --require-approval "$(cfg '.merge.require_approval')")" || continue
+    new_fp="$(jq -c '.fingerprint' <<<"$plan")"
+    if [[ "$(jq -r .run <<<"$plan")" != "true" ]]; then
+      # Remember skipped CI transitions too, so old feedback doesn't wake another worker.
+      echo "$new_fp" >"$fp_file"
+      continue
+    fi
+    (( $(capacity_left) > 0 )) || { log "at capacity"; return; }
+    echo "$new_fp" >"$fp_file"
+    local pf="$BRAIN_STATE/runs/$key.prompt"
+    prompt_env babysit
+    NOTES="$(notes_for $refs)" PR_URL="$url" HOST="$HOST_NAME" REVIEW_PANEL="$(describe_reviewers)" BRAIN_DIR="$BRAIN_DIR" \
+      MARKER="$(cfg '.pr_marker')${issue:-?}" \
+      REVIEWERS="$(cfg '.reviewers | join(",")')" AUTO_MERGE="$(cfg '.merge.auto')" \
+      render "$BRAIN_DIR/prompts/babysit.md" >"$pf"
+    BRAIN_REPO="${refs%%#*}" BRAIN_PR="${refs##*#}" spawn "$key" "$(implementer)" write "$(cfg '.limits.babysit_timeout')" "$pf"
+  done
+}
+
+cmd_review() {
+  local url="$1" dir
+  dir="$(mktemp -d "$BRAIN_STATE/review.XXXXXX")"
+  gh pr view "$url" --json headRepository,headRepositoryOwner,headRefName,baseRefName,title,body >"$dir/pr.json"
+  local nwo head base
+  nwo="$(jq -r '.headRepositoryOwner.login + "/" + .headRepository.name' "$dir/pr.json")"
+  head="$(jq -r .headRefName "$dir/pr.json")"; base="$(jq -r .baseRefName "$dir/pr.json")"
+  git clone -q --filter=blob:none --branch "$head" "git@github.com:$nwo.git" "$dir/src"
+  git -C "$dir/src" fetch -q origin "$base:refs/remotes/origin/$base"
+  log "internal review of $url by: $(describe_reviewers)"
+  cross_review "$url" "$dir/src" "origin/$base" "$dir/pr.json" | tee "$dir/findings.md"
+  rm -rf "$dir/src"
+}
+
+# Trusted Slack requests can ask for review without a GitHub reviewer request.
+chat_review_queue() {
+  local file url token key seen owner repo row owners me
+  me="$(review_owner)" || return 1
+  owners="$(cfg -o=json '.pr_review.owners')"
+  for file in "$BRAIN_STATE"/chat/review-requests/*.json; do
+    [[ -f "$file" ]] || continue
+    url="$(jq -r '.url // ""' "$file")"; token="$(jq -r '.token // ""' "$file")"
+    [[ "$url" =~ ^https://github.com/([^/]+)/([^/]+)/pull/([0-9]+)$ && -n "$token" ]] || continue
+    owner="${BASH_REMATCH[1]}"; repo="${BASH_REMATCH[2]}"; key="review-$repo-${BASH_REMATCH[3]}"
+    jq -e --arg owner "$owner" 'index($owner) != null' <<<"$owners" >/dev/null || continue
+    [[ "$repo" =~ $(cfg '.pr_review.repo_regex') ]] || continue
+    seen="$(cat "$BRAIN_STATE/prs/$key.chat-reviewed" 2>/dev/null || true)"
+    [[ "$token" == "$seen" ]] && continue
+    row="$(gh pr view "$url" --json url,author,isDraft,state)" || continue
+    if [[ "$(jq -r .state <<<"$row")" != OPEN ]]; then
+      mv "$file" "$file.closed"; continue
+    fi
+    if [[ "$(jq -r '.author.login // "" | ascii_downcase' <<<"$row")" == "$me" ]]; then
+      mv "$file" "$file.owned"; continue
+    fi
+    jq -c --arg repo "$repo" '. + {repository:{name:$repo}} | [.]' <<<"$row"
+  done
+}
+
+# Assignment, direct/team requests, mentions and trusted chat; no age cutoff.
+review_queue() {
+  local candidates combined eligible me
+  me="$(review_owner)" || return 1
+  # Capture first: failed discovery must not dispatch a partial queue.
+  if ! candidates="$(cfg -o=json '.' | "$BRAIN_DIR/bin/review-discovery")"; then
+    review_metric discovery-failed
+    return 1
+  fi
+  combined="$candidates" || { review_metric discovery-failed; return 1; }
+  jq --arg re "$(cfg '.pr_review.repo_regex')" 'map(select(.repository.name | test($re)))' <<<"$combined" >"$BRAIN_STATE/score-candidates.json.tmp"
+  mv "$BRAIN_STATE/score-candidates.json.tmp" "$BRAIN_STATE/score-candidates.json"
+  eligible="$(jq --arg me "$me" --arg re "$(cfg '.pr_review.repo_regex')" '
+    map(select(.isDraft | not) | select((.author.login // "") | ascii_downcase != $me) | select(.repository.name | test($re)))' <<<"$combined")" || { review_metric discovery-failed; return 1; }
+  printf '%s\n' "$eligible" | review_metric inventory "$(jq length <<<"$combined")" || { review_metric discovery-failed; return 1; }
+  jq -r '.[].url' <<<"$eligible"
+}
+
+# Prior feedback for deduplication; only our explicitly marked computed scores are omitted (the current score is supplied separately).
+existing_feedback() { # existing_feedback <owner/repo> <number>
+  local nwo="$1" num="$2" me
+  me="$(cfg '.owner.github')"
+  echo "## Reviews"
+  gh api "repos/$nwo/pulls/$num/reviews" --paginate | jq -r --arg me "$me" '
+    .[] | (if .user.login == $me then ((.body // "") | gsub("<!-- llm-brain:score:start -->[\\s\\S]*?<!-- llm-brain:score:end -->"; "[Previous computed score omitted; current score supplied separately.]")) else (.body // "") end) as $body
+    | select($body != "")
+    | "### \(.user.login) — \(.state) at \(.submitted_at) (commit \(.commit_id[0:8]))\n\($body)\n"'
+  echo "## Inline comments"
+  gh api "repos/$nwo/pulls/$num/comments" --paginate \
+    --jq '.[] | "### \(.user.login) on \(.path):\(.line // .original_line) at \(.created_at)\(if .in_reply_to_id then " (reply)" else "" end)\n\(.body)\n"'
+  echo "## PR comments"
+  gh api "repos/$nwo/issues/$num/comments" --paginate | jq -r --arg me "$me" '
+    .[] | select((.user.login == $me and (.body | test("^### (AI Slop|Entropy) Score:"))
+                 and (.body | test("<!-- llm-brain:(ai-slop|entropy)-score -->[[:space:]]*$"))) | not)
+    | "### \(.user.login) at \(.created_at)\n\(.body)\n"'
+}
+
+# Entropy Score of one PR head, scored in its clone. Sets SLOP (the review section) and SLOP_VERDICT for the prompt,
+# keeps each score in $BRAIN_STATE/slop/<key>/ so a re-review can say what changed, and sets the commit status.
+slop_for() { # slop_for <pr-url> <key> <head-sha> <base-branch> <dir with src/>
+  local url="$1" key="$2" sha="$3" base="$4" dir="$5" hist prev rc=0 args=()
+  SLOP="(Entropy Score is off for this fleet.)"; SLOP_VERDICT="off"
+  [[ "$(cfg '.entropy.enabled')" == "true" ]] || return 0
+  hist="$BRAIN_STATE/slop/$key"; mkdir -p "$hist"
+  prev="$(ls -t "$hist"/*.json 2>/dev/null | grep -v "/$sha.json" | head -1 || true)"   # markers (.shown/.pending) aren't .json
+  [[ -n "$prev" ]] && args+=(--previous "$prev")
+  [[ "$(cfg '.entropy.post_status')" == "true" && "$(cfg '.pr_review.post')" == "true" ]] && args+=(--post-status)
+  (cd "$dir/src" && "$BRAIN_DIR/bin/entropy-score" --base "origin/$base" --pr "$url" --out-dir "$dir/slop" ${args[@]+"${args[@]}"} \
+    >/dev/null 2>>"$dir/slop.err") || rc=$?
+  if (( rc <= 1 )) && [[ -f "$dir/slop/slop.json" ]] && jq -e --arg sha "$sha" '.head_sha == $sha and .jev == "on" and (.unassessed | length) == 0' "$dir/slop/slop.json" >/dev/null; then
+    cp "$dir/slop/slop.json" "$hist/$sha.json"
+    SLOP="$(cat "$dir/slop/slop.md")"; SLOP_VERDICT="$(jq -r .verdict "$dir/slop/slop.json")"
+    log "$key: Entropy Score $(jq -r .score "$dir/slop/slop.json")/100 ($SLOP_VERDICT)"
+  else
+    mkdir -p "$hist/$sha.failed"
+    cp "$dir/slop.err" "$hist/$sha.failed/stderr" 2>/dev/null || true
+    [[ ! -f "$dir/slop/slop.json" ]] || cp "$dir/slop/slop.json" "$hist/$sha.failed/slop.json"
+    SLOP="(Entropy Score could not run: $(tail -1 "$dir/slop.err" 2>/dev/null))"; SLOP_VERDICT="error"
+    log "$key: entropy-score failed: $(tail -1 "$dir/slop.err" 2>/dev/null)"
+  fi
+}
+
+# Score a PR's current head without an LLM and show it on the PR: one comment, edited in place on each new head,
+# plus the entropy-score commit status. For PRs that get no review on this head (the fleet's own; ones reviewed
+# before the score existed). Does nothing when that head is already scored.
+slop_publish() { # slop_publish <pr-url> [force]
+  local url="$1" force="${2:-}" nwo num key sha base base_sha dir cid me post
+  python3 "$BRAIN_DIR/bin/review_authorization.py" "$url" --score >/dev/null || return 0
+  [[ "$(cfg '.entropy.enabled')" == "true" ]] || return 0
+  [[ "$url" =~ ^https://github.com/([^/]+/[^/]+)/pull/([0-9]+) ]] || return 0
+  nwo="${BASH_REMATCH[1]}"; num="${BASH_REMATCH[2]}"; key="review-${nwo#*/}-$num"
+  sha="$(gh pr view "$url" --json headRefOid --jq .headRefOid)" || return 1
+  post="$(cfg '.pr_review.post')"
+  # done = shown on the PR (or scored, on a dry run); a score that failed to post is retried next tick
+  [[ -z "$force" && -f "$BRAIN_STATE/slop/$key/$sha.$([[ "$post" == "true" ]] && echo shown || echo json)" ]] && return 0
+  base_sha="$(gh api "repos/$nwo/pulls/$num" --jq .base.sha)" || return 1
+  [[ "$base_sha" =~ ^[0-9a-f]{40}$ ]] || return 1
+  base="score-base"
+  dir="$(mktemp -d "$BRAIN_STATE/slop-run.XXXXXX")"
+  if git clone -q --filter=blob:none --no-checkout "git@github.com:$nwo.git" "$dir/src" \
+     && git -C "$dir/src" fetch -q origin "pull/$num/head" "$base_sha:refs/remotes/origin/$base" && git -C "$dir/src" checkout -q --detach "$sha"; then
+    slop_for "$url" "$key" "$sha" "$base" "$dir"
+    if [[ "$SLOP_VERDICT" == error ]]; then
+      rm -rf "$dir"; return 1
+    fi
+    if [[ "$(gh pr view "$url" --json headRefOid --jq .headRefOid)" != "$sha" ]]; then
+      rm -rf "$dir"; return 1
+    fi
+    if [[ "$SLOP_VERDICT" != "error" && "$SLOP_VERDICT" != "off" && "$post" == "true" ]]; then
+      python3 "$BRAIN_DIR/bin/review_authorization.py" "$url" --score >/dev/null || { rm -rf "$dir"; return 0; }
+      touch "$BRAIN_STATE/slop/$key/$sha.pending"
+      printf '%s\n\nAssessed head: `%s`\n\n<!-- llm-brain:entropy-score -->\n' "$SLOP" "$sha" >"$dir/comment.md"
+      if ! python3 "$BRAIN_DIR/bin/comment_language.py" "$dir/comment.md"; then
+        log "$key: comment language check failed; keep the score pending"
+        rm -rf "$dir"; return 1
+      fi
+      # our own marker comment only (never someone's quote of it); a failed lookup must not become a duplicate
+      if me="$(gh api user --jq .login)" && cid="$(gh api "repos/$nwo/issues/$num/comments" --paginate --jq \
+           ".[] | select(.user.login == \"$me\" and (.body | test(\"^### (AI Slop|Entropy) Score:\")) and (.body | test(\"<!-- llm-brain:(ai-slop|entropy)-score -->[[:space:]]*$\"))) | .id")"; then
+        cid="$(tail -1 <<<"$cid")"
+        if { [[ -n "$cid" ]] && gh api -X PATCH "repos/$nwo/issues/comments/$cid" -F body=@"$dir/comment.md" >/dev/null; } \
+           || { [[ -z "$cid" ]] && gh api "repos/$nwo/issues/$num/comments" -F body=@"$dir/comment.md" >/dev/null; }; then
+          touch "$BRAIN_STATE/slop/$key/$sha.shown"; rm -f "$BRAIN_STATE/slop/$key/$sha.pending"
+          log "$key: Entropy Score shown on $url"
+        else
+          log "$key: could not post the Entropy Score comment on $url; retrying next tick"
+          rm -rf "$dir"; return 1
+        fi
+      else
+        log "$key: could not read the comments on $url; retrying next tick"
+        rm -rf "$dir"; return 1
+      fi
+    fi
+  else
+    log "slop: clone failed for $url"
+    rm -rf "$dir"; return 1
+  fi
+  rm -rf "$dir"
+}
+
+cmd_slop() { # fleet entropy <pr-url> [--post]
+  local url="${1:?usage: fleet entropy <pr-url> [--post]}" post="${2:-}" dir nwo num base
+  [[ "$post" == "--post" ]] && { slop_publish "$url" force; return; }   # score it, comment, set the status
+  [[ "$url" =~ ^https://github.com/([^/]+/[^/]+)/pull/([0-9]+) ]] || die "not a PR url: $url"
+  nwo="${BASH_REMATCH[1]}"; num="${BASH_REMATCH[2]}"
+  dir="$(mktemp -d "$BRAIN_STATE/slop-run.XXXXXX")"
+  gh pr view "$url" --json baseRefName,state,mergeCommit >"$dir/pr.json"
+  base="$(jq -r .baseRefName "$dir/pr.json")"
+  # pull/N/head exists for merged PRs (branch deleted) and forks alike
+  git clone -q --filter=blob:none --no-checkout "git@github.com:$nwo.git" "$dir/src" \
+    && git -C "$dir/src" fetch -q origin "pull/$num/head:refs/slop/head" "$base:refs/remotes/origin/$base" \
+    && git -C "$dir/src" checkout -q --detach refs/slop/head || { rm -rf "$dir"; die "clone failed for $url"; }
+  local against="origin/$base" mc
+  mc="$(jq -r '.mergeCommit.oid // empty' "$dir/pr.json")"
+  # a merged PR's head is inside its base branch; compare with the base as it was just before the merge
+  [[ "$(jq -r .state "$dir/pr.json")" == "MERGED" && -n "$mc" ]] && against="$mc^1"
+  (cd "$dir/src" && "$BRAIN_DIR/bin/entropy-score" --base "$against" --pr "$url" ${post:+--post-status}) || true
+  rm -rf "$dir"
+}
+
+post_mode() {
+  if [[ "$(cfg '.pr_review.post')" == "true" ]]; then
+    echo "POST the review to GitHub as described below."
+  else
+    echo "DRY RUN: do NOT post anything to GitHub. Write the exact JSON body you would send to the reviews API to $1/review.json, and the rendered review (body + each inline comment with path:line) as markdown to $1/review.md."
+  fi
+}
+
+cmd_review_prs() {
+  local me monitoring_config
+  me="$(review_owner)" || { review_metric discovery-failed; log "invalid review owner"; return 1; }
+  monitoring_config="$(cfg -o=json '.')"
+  if paused; then monitoring_config="$(jq '.paused = true' <<<"$monitoring_config")"; fi
+  printf '%s\n' "$monitoring_config" | review_metric begin || return 1
+  paused && { log "paused"; return; }
+  [[ "$(cfg '.pr_review.enabled')" == "true" ]] || return 0
+  local review_provider review_model
+  review_provider="$(cfg '.pr_review.provider')"
+  review_model="$(cfg '.pr_review.model // ""')"
+  local url key sha last dir pf nwo base num prior lf fails scope chat_repo chat_num chat_token chat_seen feedback_only backfilled=0 queue
+  queue="${ONLY_PR:-}"
+  if [[ -z "$queue" ]]; then queue="$(review_queue)" || return 1; fi
+  if [[ "$(cfg '.pr_review.engine // "cli"')" == api ]]; then
+    # Foreground ownership: launchd must not kill unfinished background children.
+    if [[ -n "${ONLY_PR:-}" ]]; then
+      "$BRAIN_DIR/bin/api-review-queue" enqueue "$ONLY_PR" --priority 100
+    else
+      "$BRAIN_DIR/bin/api-review-queue" inventory <"$BRAIN_STATE/score-candidates.json"
+    fi
+    if [[ "$(cfg '.pr_review.post')" == true ]]; then
+      "$BRAIN_DIR/bin/api-review-queue" tick --limit 12 --budget 0.10 --post
+    else
+      "$BRAIN_DIR/bin/api-review-queue" tick --limit 12 --budget 0.10
+    fi
+    # Scores run in com.llm-brain.scores, independently of review latency.
+    return
+  fi
+  if [[ "$(cfg '.entropy.enabled')" == true && -z "${ONLY_PR:-}" ]]; then
+    nohup "$BRAIN_DIR/bin/score-publisher" >>"$BRAIN_STATE/logs/score-publisher.log" 2>&1 </dev/null &
+  fi
+  if [[ "$(cfg '.gateway.enabled')" == true ]]; then
+    if ! review_provider="$(printf '%s\n' "$monitoring_config" | review_metric provider)"; then
+      review_metric wait quota; log "no configured review provider has fresh spendable allowance"; return
+    fi
+    if [[ "$review_provider" != "$(cfg '.pr_review.provider')" ]]; then
+      review_model="$(cfg ".providers.$review_provider.model")"
+      log "using configured gated review fallback: $review_provider"
+    fi
+  fi
+  for url in $queue; do
+    python3 "$BRAIN_DIR/bin/review_authorization.py" "$url" >/dev/null || continue
+    key="review-$(sed -E 's#https://github.com/[^/]+/([^/]+)/pull/([0-9]+)#\1-\2#' <<<"$url")"
+    # never review my own PRs (the queue filters them too; this covers `review-pr <url>`)
+    [[ "$(gh pr view "$url" --json author --jq .author.login | tr '[:upper:]' '[:lower:]')" == "$me" ]] && { log "$url is mine — not reviewing"; continue; }
+    sha="$(gh pr view "$url" --json headRefOid --jq .headRefOid)"
+    review_metric head "$url" "$sha" || return 1
+    worker_running "$key" && continue
+    last="$(cat "$BRAIN_STATE/prs/$key.reviewed" 2>/dev/null || true)"
+    chat_repo="${url#https://github.com/}"; chat_repo="${chat_repo%/pull/*}"; chat_num="${url##*/}"
+    chat_token="$(cat "$BRAIN_STATE/chat/review-requests/${chat_repo/\//__}__${chat_num}.sha256" 2>/dev/null || true)"
+    chat_seen="$(cat "$BRAIN_STATE/prs/$key.chat-reviewed" 2>/dev/null || true)"
+    feedback_only=false
+    local budget_retry=false
+    if [[ "$sha" == "$last" ]]; then                        # one review per head commit…
+      lf="$(ls -t "$BRAIN_STATE/logs/$key".*.log 2>/dev/null | head -1)"
+      fails="$(cat "$BRAIN_STATE/prs/$key.fails" 2>/dev/null || echo 0)"
+      if [[ -n "$lf" ]] && (( $(review_capacity_left) > 0 )) && printf '%s\n' "$monitoring_config" | review_metric retry-budget "$url" "$sha" "$lf"; then
+        budget_retry=true
+        log "$key: bounded retry after a fresh budget window"
+      elif [[ -n "$lf" ]] && grep -Eq '^BUDGET_STOPPED |Session (request|output) budget reached|Quota unknown or stale|Emergency reserve protected' "$lf"; then
+        review_metric budget "$url"
+        log "$key: resource budget stopped this review — needs a human handoff, not an automatic retry"
+        continue
+      fi
+      if [[ "$budget_retry" == true ]]; then
+        : # Existing gateway identity and consumed budgets are retained.
+      elif [[ -n "$chat_token" && "$chat_token" != "$chat_seen" ]]; then
+        feedback_only=true
+        log "$key: new trusted Slack request — bounded feedback pass on the same head"
+      elif [[ -n "$lf" ]] && ! grep -q '^REVIEWED ' "$lf" && (( fails < 3 )); then
+        echo $((fails + 1)) >"$BRAIN_STATE/prs/$key.fails"  # …unless that review died without posting
+        log "$key: last review produced no result — retry $((fails + 1))/3"
+      else
+        # reviewed before the score existed: score it and show it as a comment, a few PRs per tick
+        if [[ ! -f "$BRAIN_STATE/slop/$key/$sha.json" || -f "$BRAIN_STATE/slop/$key/$sha.pending" ]] && (( backfilled < $(cfg '.entropy.backfill_per_tick // 3') )); then
+          backfilled=$((backfilled + 1)); slop_publish "$url" || true
+        fi
+        continue
+      fi
+    else
+      rm -f "$BRAIN_STATE/prs/$key.fails"
+    fi
+    (( $(review_capacity_left) > 0 )) || { review_metric wait capacity; log "review pool full"; return; }
+    dir="$BRAIN_STATE/reviews/$key"; rm -rf "$dir"; mkdir -p "$dir"
+    gh pr view "$url" --json headRepository,headRepositoryOwner,headRefName,baseRefName,number >"$dir/pr.json"
+    nwo="$(jq -r '.headRepositoryOwner.login + "/" + .headRepository.name' "$dir/pr.json")"
+    base="$(jq -r .baseRefName "$dir/pr.json")"; num="$(jq -r .number "$dir/pr.json")"
+    git clone -q --filter=blob:none --branch "$(jq -r .headRefName "$dir/pr.json")" "git@github.com:$nwo.git" "$dir/src" \
+      && git -C "$dir/src" fetch -q origin "$base:refs/remotes/origin/$base" || { review_metric failure "$url" clone_failed; log "clone failed for $url"; continue; }
+    existing_feedback "$nwo" "$num" >"$dir/existing.md"
+    slop_for "$url" "$key" "$sha" "$base" "$dir"
+    prior=""; scope="origin/$base"
+    lf="$(ls -t "$BRAIN_STATE/logs/$key".*.log 2>/dev/null | head -1 || true)"
+    if [[ "$feedback_only" == true && -n "$lf" ]] && grep -q '^REVIEWED ' "$lf"; then
+      scope="$sha"
+      prior="SAME-HEAD SLACK FOLLOW-UP. There is no new code delta. Read the trusted Slack instructions, inspect only their directly relevant code/contracts and review readiness, and report new unresolved points. Do not repeat a full review or merge/deploy anything."
+    elif [[ -n "$last" && "$last" != "$sha" && -n "$lf" ]] && grep -q '^REVIEWED ' "$lf" \
+       && git -C "$dir/src" merge-base --is-ancestor "$last" HEAD 2>/dev/null; then
+      scope="$last"
+      prior="This is a RE-REVIEW of changes since ${last:0:8}. Review only that delta plus directly affected code and whether earlier findings were resolved. Do not repeat a full unchanged-file review."
+    fi
+    pf="$dir/prompt.md"
+    prompt_env pr-review
+    NOTES="$(notes_for "$chat_repo#$chat_num")" PR_URL="$url" HOST="$HOST_NAME" BRAIN_DIR="$BRAIN_DIR" HEAD_SHA="$sha" BASE="origin/$base" REVIEW_BASE="$scope" NWO="$nwo" NUMBER="$num" PRIOR="$prior" EXISTING="$dir/existing.md" POST_MODE="$(post_mode "$dir")" SLOP="$SLOP" SLOP_VERDICT="$SLOP_VERDICT" \
+      render "$BRAIN_DIR/prompts/pr-review.md" >"$pf"
+    echo "$sha" >"$BRAIN_STATE/prs/$key.reviewed"
+    printf '%s\n' "$chat_token" >"$BRAIN_STATE/prs/$key.chat-reviewed"
+    BRAIN_REVIEW_BUDGET_RETRY="$budget_retry" BRAIN_REVIEW_URL="$url" BRAIN_REVIEW_SHA="$sha" BRAIN_REVIEW_OWNER="$me" \
+    LLM_MODEL="$review_model" BRAIN_REPO="$nwo" BRAIN_PR="$num" SPAWN_CWD="$dir/src" spawn "$key" "$review_provider" write "$(cfg '.limits.review_timeout')" "$pf"
+  done
+}
+
+# Snapshot for the dashboard: everything it shows, so the web server never calls GitHub.
+cmd_snapshot() {
+  local tmp="$BRAIN_STATE/status.json.tmp" workers=() f k pid lf
+  for f in "$BRAIN_STATE"/runs/*.pid; do
+    [[ -e "$f" ]] || continue
+    k="$(basename "$f" .pid)"; pid="$(cat "$f")"
+    kill -0 "$pid" 2>/dev/null || continue
+    lf="$(ls -t "$BRAIN_STATE/logs/$k".*.log 2>/dev/null | head -1)"
+    workers+=("$(jq -nc --arg k "$k" --arg pid "$pid" --arg log "$(basename "${lf:-}")" \
+      --arg since "$(stat -f %Sm -t '%Y-%m-%dT%H:%M:%S' "$f")" '{key:$k,pid:$pid,log:$log,since:$since}')")
+  done
+  local owned queue prs reviews
+  owned="$(for repo in $(cfg '.intake.repos[]'); do
+      gh issue list -R "$repo" --state open --assignee "$(cfg '.intake.assignee')" \
+        --search "label:\"$(cfg '.labels.claimed')\",\"$(cfg '.labels.pr_open')\",\"$(cfg '.labels.blocked')\"" \
+        --json number,title,url,labels,author,updatedAt; done | jq -s 'add // []')"
+  queue="$(intake_queue | while read -r r n; do
+      gh issue view "$n" -R "$r" --json number,title,url,author,createdAt \
+        | jq -c --argjson hand "$(has_my_open_pr "$n" && echo true || echo false)" '. + {by_hand:$hand}'; done | jq -s '.')"
+  prs="$(fleet_prs | jq -c '.[]' | while read -r row; do
+      gh pr view "$(jq -r .url <<<"$row")" --json url,title,number,headRefName,reviewDecision,mergeStateStatus,statusCheckRollup,updatedAt \
+        | jq -c '{url,title,number,reviewDecision,mergeStateStatus,updatedAt,
+                  ci: ([.statusCheckRollup[]? | (.conclusion // .state // .status)] | if length==0 then "none"
+                       elif any(.=="FAILURE" or .=="ERROR" or .=="TIMED_OUT") then "failing"
+                       elif any(.=="IN_PROGRESS" or .=="QUEUED" or .=="PENDING" or .=="EXPECTED") then "running" else "passing" end)}'
+    done | jq -s '.')"
+  reviews="$(for lf in $(ls -t "$BRAIN_STATE"/logs/review-*.log 2>/dev/null | head -40); do
+      line="$(grep -m1 '^REVIEWED ' "$lf" || true)"
+      jq -nc --arg log "$(basename "$lf")" --arg line "$line" --arg at "$(stat -f %Sm -t '%Y-%m-%dT%H:%M:%S' "$lf")" \
+        '{log:$log, at:$at, url:($line|split(" ")[1] // null), verdict:($line|split(" ")[2] // "running/failed"),
+          detail:($line|split(" ")[3:]|join(" "))}'
+    done | jq -s '.')"
+  jq -n --arg host "$HOST" --arg at "$(date '+%Y-%m-%dT%H:%M:%S')" --argjson paused "$(paused && echo true || echo false)" \
+    --arg impl "$(implementer)" --arg rev "$(reviewer)" --arg prov "$(cfg '.pr_review.provider')" \
+    --argjson max "$(cfg '.intake.max_in_flight')" --argjson owned "$owned" --argjson queue "$queue" \
+    --argjson prs "$prs" --argjson reviews "$reviews" \
+    --argjson workers "$(printf '%s\n' "${workers[@]+"${workers[@]}"}" | jq -s '.')" \
+    --arg tail "$(tail -40 "$BRAIN_STATE/logs/fleet.log" 2>/dev/null)" \
+    --argjson chat "$(cat "$BRAIN_STATE/chat/digest.json" 2>/dev/null || echo null)" \
+    '{host:$host, at:$at, paused:$paused, roles:{implementer:$impl, internal_reviewer:$rev, pr_reviewer:$prov},
+      max_in_flight:$max, owned:$owned, queue:$queue, prs:$prs, reviews:$reviews, workers:$workers, log:$tail, chat:$chat}' >"$tmp"
+  mv "$tmp" "$BRAIN_STATE/status.json"
+}
+
+cmd_status() {
+  echo "host: $HOST_NAME ($HOST)   role: $(node_role)   paused: $(paused && echo yes || echo no)   implementer: $(implementer)"
+  echo "reviewers: $(describe_reviewers)"
+  echo "workers: $(running_workers)/$(cfg '.limits.max_workers')"
+  for f in "$BRAIN_STATE"/runs/*.pid; do [[ -e "$f" ]] && echo "  - $(basename "$f" .pid) (pid $(cat "$f"))"; done
+  echo; echo "claimed issues:"
+  for repo in $(cfg '.intake.repos[]'); do
+    gh issue list -R "$repo" --state open --label "$(cfg '.labels.claimed')" --json number,title,labels \
+      --jq '.[] | "  #\(.number) \(.title)  [\([.labels[].name | select(startswith("agent"))] | join(","))]"'
+  done
+  echo; echo "fleet PRs:"
+  fleet_prs | jq -r '.[] | "  \(.url)  (updated \(.updatedAt))"'
+}
+
+cmd_labels() {
+  local repo
+  for repo in $(cfg '.intake.repos[]'); do
+    gh label create "$(cfg '.intake.label')" -R "$repo" --color 0E8A16 --description "Opt-in: the llm-brain agent fleet may implement this issue" --force
+    gh label create "$(cfg '.labels.claimed')" -R "$repo" --color FBCA04 --description "llm-brain fleet is implementing this" --force
+    gh label create "$(cfg '.labels.pr_open')" -R "$repo" --color 1D76DB --description "llm-brain fleet has a PR open for this" --force
+    gh label create "$(cfg '.labels.blocked')" -R "$repo" --color D93F0B --description "llm-brain fleet needs a human decision" --force
+    gh label create "$(cfg '.labels.stop')" -R "$repo" --color 000000 --description "llm-brain fleet must not touch this" --force
+    gh label create "$(cfg '.labels.done')" -R "$repo" --color C5DEF5 --description "llm-brain fleet: nothing left to build; needs a human/UAT check" --force
+  done
+}
+
+case "${1:-}" in
+  tick)
+    # One tick at a time on this machine: a slow tick (a long chat digest) must not overlap the next one,
+    # or both dispatch the same issue. A lock whose owner is gone is taken over.
+    lock="$BRAIN_STATE/tick.lock"
+    if ! mkdir "$lock" 2>/dev/null; then
+      # Held by a live fleet process (not a recycled pid), and not for over an hour (ticks take minutes).
+      lp="$(cat "$lock/pid" 2>/dev/null)"
+      if [[ -n "$lp" ]] && ps -p "$lp" -o command= 2>/dev/null | grep -q "bin/fleet" &&
+         [[ -z "$(find "$lock" -maxdepth 0 -mmin +60 2>/dev/null)" ]]; then
+        log "tick: previous tick still running — skipping"; exit 0
+      fi
+      rm -rf "$lock"; mkdir "$lock" || exit 0
+    fi
+    echo $$ >"$lock/pid"
+    trap 'rm -rf "$lock"' EXIT
+    python3 "$BRAIN_DIR/bin/brain-pr-policy" --reconcile >>"$BRAIN_STATE/logs/agent-attribution.log" 2>&1 || { log "agent attribution reconciliation failed; implementation dispatch paused"; exit 75; }
+    log "tick"; "$BRAIN_DIR/bin/chat-watch" 2>>"$BRAIN_STATE/logs/fleet.log" || true; cmd_dispatch || true; cmd_babysit || true; cmd_review_prs || true; cmd_snapshot ;;
+  intake-config) cfg -o=json '.intake' ;;
+  intake-candidates) paused || intake_queue ;;
+  intake-prompt)
+    shift; repo="$1"; num="$2"
+    prompt_env implement
+    NOTES="$(notes_for "$repo#$num")" REPO="$repo" ISSUE="$num" HOST="$HOST_NAME" REVIEWER="${4:-$(reviewer)}" IMPLEMENTER="${3:-$(implementer)}" \
+      SESSION_KIND="interactive" INTERACTION_RULE="The owner can reply through the hub or Telegram. Ask the owner when a decision is needed, then wait for their reply." \
+      BLOCK_RULE="Ask the exact question in this session and wait. Do not contact teammates or mark the issue blocked unless the owner directs you to." \
+      BRAIN_DIR="$BRAIN_DIR" MARKER="$(cfg '.pr_marker')$num" REVIEWERS="$(cfg '.reviewers | join(",")')" render "$BRAIN_DIR/prompts/implement.md" ;;
+  snapshot) cmd_snapshot ;;
+  review-prs) cmd_review_prs ;;
+  review-status) review_metric status ;;
+  review-pr) shift; ONLY_PR="$1" cmd_review_prs ;;
+  dispatch) cmd_dispatch ;;
+  babysit) cmd_babysit ;;
+  review) shift; cmd_review "$@" ;;
+  entropy|slop) shift; cmd_slop "$@" ;;
+  status) cmd_status ;;
+  prs) fleet_prs | jq . ;;
+  labels) cmd_labels ;;
+  pause) touch "$BRAIN_LOCAL/PAUSE"; log "paused $HOST" ;;
+  resume) rm -f "$BRAIN_LOCAL/PAUSE"; log "resumed $HOST" ;;
+  providers) echo "available: $(available_providers | tr '\n' ' ')"; echo "implementer: $(implementer)"; echo "reviewers: $(describe_reviewers)" ;;
+  *) sed -n '2,14p' "$0"; exit 1 ;;
+esac
diff --git a/hub/policyassets/bin/llm-run b/hub/policyassets/bin/llm-run
new file mode 100755
index 0000000..022a201
--- /dev/null
+++ b/hub/policyassets/bin/llm-run
@@ -0,0 +1,87 @@
+#!/usr/bin/env bash
+# llm-run <provider> <mode> <cwd> <prompt-file> [session-name]
+#
+# One adapter for every LLM CLI so the fleet never hard-codes a vendor.
+#   mode=write   full tool access (implementation, PR babysitting)
+#   mode=review  read-only (internal review); prints findings to stdout
+set -euo pipefail
+source "$(dirname "$0")/lib.sh"
+
+provider="$1" mode="$2" cwd="$3" prompt_file="$4" name="${5:-llm-brain}"
+export BRAIN_PROVIDER="$provider" BRAIN_AGENT="$name"
+export PATH="$BRAIN_DIR/bin/agent-tools:$PATH"
+prompt="$(cat "$BRAIN_DIR/prompts/comment-language.md")"$'\n\n'"$(cat "$prompt_file")"
+model="${LLM_MODEL:-$(cfg ".providers.$provider.model")}"
+cd "$cwd"
+
+# Shared memory: add what other agents learned about this repo/issue and who else is on it, and how to save a
+# lesson. It fails open: no hub or no memory leaves the prompt as it was.
+if [[ "$(cfg '.memory.enabled')" == "true" ]]; then
+  export BRAIN_PROVIDER="$provider" BRAIN_AGENT="$name"
+  mem="$(BRAIN_HUB_URL="${BRAIN_HUB_URL:-$(cfg '.memory.hub_url // .hub_url')}" "$BRAIN_DIR/bin/brain-context" --k "$(cfg '.memory.k // 8')" 2>/dev/null || true)"
+  [[ -n "$mem" ]] && prompt+=$'\n\n'"$mem"
+  prompt+=$'\n\n'"When you learn something non-obvious the next agent here would need (a gotcha, a decision and why, how to run or test something), save it with \`$BRAIN_DIR/bin/brain-remember <fact|decision|gotcha|runbook|handoff> \"<title>\" \"<the lesson>\" [--files a,b]\`. Keep it small and verbatim, never a secret. If you stop before the work is done, save a handoff."
+fi
+
+# Route through the account gateway when it is enabled and reachable.
+GW=""
+if [[ "$(cfg '.gateway.enabled')" == "true" ]]; then
+  envf="$(cfg '.gateway.env_file')"; envf="${envf/#\~/$HOME}"
+  [[ -f "$envf" ]] && source "$envf"
+  url="$(cfg '.gateway.url')"
+  if [[ -n "${CPA_API_KEY:-}" ]] && curl -fsS -m 3 -o /dev/null -H @- "$url/v1/models" <<<"Authorization: Bearer $CPA_API_KEY"; then
+    GW="$url"; export CPA_API_KEY
+    if [[ -n "${BRAIN_REVIEW_URL:-}" && -n "${BRAIN_REVIEW_OWNER:-}" ]]; then
+      # Durable across restarts, retries and new heads. Never rekey a stopped PR.
+      identity="$(printf '%s\n%s' "$(tr '[:upper:]' '[:lower:]' <<<"$BRAIN_REVIEW_OWNER")" "$BRAIN_REVIEW_URL" | shasum -a 256 | cut -d ' ' -f1)"
+      GW="$url/r/$identity"
+    fi
+  else
+    log "configured hub gateway unavailable — paused; direct paid-account fallback is disabled"
+    exit 75
+  fi
+fi
+
+case "$provider" in
+  claude)
+    [[ -n "$GW" ]] && export ANTHROPIC_BASE_URL="$GW" ANTHROPIC_AUTH_TOKEN="$CPA_API_KEY"
+    args=(-p "$prompt" --name "$name" --output-format text)
+    [[ -n "$model" ]] && args+=(--model "$model")
+    if [[ "$mode" == "write" ]]; then
+      args+=(--dangerously-skip-permissions)
+    else
+      args+=(--permission-mode plan --allowedTools "Read,Grep,Glob,Bash(git diff:*),Bash(git log:*),Bash(git show:*),Bash(gh pr view:*),Bash(gh pr diff:*)")
+    fi
+    # A budget hook stops Claude's loop, but the CLI may report exit 0. Preserve
+    # human-readable output while translating a guard stop to an incomplete run.
+    budget_stop="$(mktemp "$BRAIN_STATE/runs/budget-stop.XXXXXX")"
+    trap 'rm -f "$budget_stop"' EXIT
+    export BRAIN_CLAUDE_BUDGET_STOP_FILE="$budget_stop"
+    rc=0
+    claude "${args[@]}" || rc=$?
+    if [[ -s "$budget_stop" ]]; then
+      printf 'BUDGET_STOPPED %s\n' "$(cat "$budget_stop")" >&2
+      exit 75
+    fi
+    exit "$rc"
+    ;;
+  codex)
+    args=(exec -C "$cwd" --skip-git-repo-check)
+    [[ -n "$GW" ]] && args+=(-c model_provider=cpa
+      -c "model_providers.cpa={name=\"CPA\",base_url=\"$GW/v1\",env_key=\"CPA_API_KEY\",wire_api=\"responses\",requires_openai_auth=false}")
+    [[ -n "$model" ]] && args+=(-m "$model")
+    if [[ "$mode" == "write" ]]; then
+      args+=(--dangerously-bypass-approvals-and-sandbox)
+    else
+      args+=(--sandbox read-only)
+    fi
+    exec codex "${args[@]}" "$prompt"
+    ;;
+  gemini)
+    args=(-p "$prompt")
+    [[ -n "$model" ]] && args+=(-m "$model")
+    [[ "$mode" == "write" ]] && args+=(--yolo)
+    exec gemini "${args[@]}"
+    ;;
+  *) die "unknown provider: $provider" ;;
+esac
diff --git a/hub/policyassets/prompts/babysit.md b/hub/policyassets/prompts/babysit.md
new file mode 100644
index 0000000..f1af4c8
--- /dev/null
+++ b/hub/policyassets/prompts/babysit.md
@@ -0,0 +1,67 @@
+Agent attribution is mandatory. Create PRs through the managed gh adapter. Every agent-assisted PR must have agent:assisted, agent:author:<provider>, and agent:pr-open labels; apply these to the PR itself, not only the issue. Keep a Co-authored-by or Assisted-by trailer on agent commits. Never approve a PR or request changes; post advisory findings only.
+
+You are an unattended llm-brain fleet worker on host `{{HOST}}`, acting for {{OWNER}} (GitHub {{OWNER_GH}}).
+Nobody is watching this session. Do not ask questions — decide, or mark blocked.
+
+# Task
+Shepherd PR {{PR_URL}} to merge. Something changed on it since the last pass (commits, reviews, comments, or CI).
+
+1. Read the PR, every review, every inline comment and CI: `gh pr view {{PR_URL}} --comments`, `gh api` for review comments, `gh pr checks {{PR_URL}}`.
+   The issue number is in the PR body marker `llm-brain:issue=N`; read that issue too. If this PR's body doesn't end with
+   `<!-- {{MARKER}} -->` yet, add it (`gh api -X PATCH repos/<owner>/<repo>/pulls/<n> -F body=@file`; `gh pr edit` can fail
+   with a "Projects (classic)" error).
+   **Any new PR you open** (a companion API/mock PR, a follow-up) ends its body with that same line, `<!-- {{MARKER}} -->`,
+   or nothing will ever shepherd it to merge.
+2. Address every unresolved review comment (people you'll see: {{PEOPLE}}, and review bots), and every chat note below that isn't done yet. Fix in the PR's branch (make a worktree for
+   it if needed). Reply on each thread with what you changed, or why you disagree — disagreeing is fine when you're right; be specific.
+3. CI failures: read the logs (`gh run view --log-failed`) and fix real failures. Re-run only proven flakes.
+4. After pushing fixes, run the cross-review again: `{{BRAIN_DIR}}/bin/fleet review {{PR_URL}}` (reviewers: {{REVIEW_PANEL}}).
+   Every finding from any reviewer must be fixed or answered in a PR comment titled "Internal review" (name the reviewer).
+   Then the Entropy Score, in the PR's worktree: `{{BRAIN_DIR}}/bin/entropy-score --base origin/<base-branch> --pr {{PR_URL}} --post-status`.
+   Fix what it lists (code, tests, title, description) until it is not `blocked`; treat its items like review comments.
+   Never add `entropy:allow` (or the old `slop:allow`) waivers yourself. A waiver a person added stays.
+5. Make sure {{REVIEWERS}} is requested as reviewer.
+
+# Write the least code
+Decision ladder adapted from Ponytail (https://ponytail.dev, MIT, by DietrichGebert).
+Before you write a fix, go down this list. Stop at the first step that holds.
+1. Does it need to exist? If not, do not build it.
+2. Is it already in this codebase? Reuse it.
+3. Does the standard library do it? Use that.
+4. Does the platform do it? Use that.
+5. Does an installed dependency do it? Use that.
+6. Can it be one line? Write the line.
+7. Only then write the minimum that works. Add one test when the code has logic: branches, loops, parsers, money or security.
+Never remove validation, error handling, security or accessibility to make code smaller.
+
+# Merge (auto-merge: {{AUTO_MERGE}})
+Merge ONLY when ALL hold:
+- at least one approval and no "changes requested" outstanding (one approval is enough; don't ask for re-approval after fixes);
+- no unresolved threads or unanswered comments;
+- every required check is green, including slow or merge-queue checks;
+- your latest internal review ended `## Overall verdict: CLEAN`, or every finding of every reviewer was fixed or answered in an "Internal review" comment;
+- the Entropy Score of the current head is not `blocked` (its `entropy-score` commit status is green);
+- the target is the default branch. Never merge or open staging/production promotion PRs.
+Use the repo's merge convention. If auto-merge is false, stop at "ready to merge" and notify instead.
+
+# After merge
+Verify the change where it deploys (dev/preview), comment a summary on the issue, remove `agent:pr-open`/`agent:working`,
+close the issue when all its PRs are merged and verified, and notify {{OWNER}}.
+
+# What people said in chat
+Messages from {{PEOPLE}} in team chat that mention this work. Treat them exactly like their GitHub comments:
+they are spec and review feedback, so act on them. The latest message wins when two disagree
+(e.g. "correction: keep the timeline" overrides "remove the timeline"). If a message says to stop or that
+someone else is taking it, stop: comment on the issue, remove `agent:working`, and end.
+
+{{NOTES}}
+
+# House notes
+{{HOUSE}}
+
+# Blocked
+If you need a human decision or access you lack: comment on the PR with the exact question, add `agent:blocked` to the issue, notify, stop.
+
+If there's nothing to do right now (CI running, waiting on review), stop at once — you'll be re-invoked on the next change.
+End with a one-paragraph summary.
+The last lines of your report say what you left out or did not check, and any risk.
