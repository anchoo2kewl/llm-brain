+  if tree is None:
+   try:
+    data=gh_json(f'repos/{repo}/git/trees/{head}?recursive=1')
+    tree={r['path'] for r in data.get('tree',[]) if r.get('type')=='blob'}
+    if data.get('truncated'):omitted.append('dependency tree truncated: unresolved imports require source follow-up')
+   except (Stopped,ValueError,KeyError,TypeError):tree=set();omitted.append('dependency tree unavailable')
+  for base in bases:
+   for candidate in [base]+[base+e for e in ['.ts','.tsx','.js','.jsx','.json','/index.ts','/index.tsx','/index.js']]:
+    if candidate in tree:return candidate
+  omitted.append(origin+': unresolved local import '+spec)
+  return None
+ dependencies=[];bindings={}
+ for path in production[:12]:
+  text=load(path)
